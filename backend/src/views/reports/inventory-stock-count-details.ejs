<%
  const rows = reportData.rows || [];
  const costs = reportData.canViewCostFields;
  const n = value => value == null ? '-' : formatNumberDisplay(value, { decimals: 3, fallback: '0' });
  const m = value => value == null ? '-' : formatNumberDisplay(value, { decimals: 2, fallback: '0' });
  const stockEntries = [{id:'RM',labelKey:'raw_material'},{id:'SFG',labelKey:'semi_finished'},{id:'FG',labelKey:'finished_goods'},{id:'WIP',labelKey:'stock_count_wip'}];
  const departmentEntries = [...options.departments, {id:'__UNASSIGNED__',labelKey:'production_report_unassigned'}];
  const columns = [
    ['date','date'],['voucherNo','voucher_no'],['status','status'],['branchName','branch'],['reasonName','reason'],
    ['sourceKey','stock_count_source'],['stockType','item_type'],['departmentName','department'],['articleName','article'],['skuCode','sku'],['unit','unit'],
    ['systemQty','stock_count_system_qty'],['countedQty','stock_count_counted_qty'],['difference','stock_count_difference'],['postedIn','stock_count_posted_in'],['postedOut','stock_count_posted_out'],
    ...(costs ? [['unitCost','stock_count_unit_cost'],['increaseValue','stock_count_increase_value'],['decreaseValue','stock_count_decrease_value'],['netValue','stock_count_net_value']] : []),['notes','remarks'],
  ];
%>
<div class="mx-auto w-full max-w-none space-y-4 px-2">
  <section class="rounded-2xl border border-slate-200 bg-white p-3 shadow-sm">
    <%- include('../base/partials/report-help-header', {title:t('stock_count_details_report'),tooltipText:t('stock_count_details_help')}) %>
    <form method="post" action="<%= reportPath %>" class="mt-3 max-w-6xl rounded-xl border border-slate-200 bg-slate-50/30 p-3 sm:p-4">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="load_report" value="1">
      <div class="space-y-3">
        <% for (const [field,key,value] of [['from_date','from_date',filters.from],['to_date','to_date',filters.to]]) { %>
          <div class="grid grid-cols-1 items-start gap-1.5 sm:grid-cols-12">
            <label for="report-<%= field %>" class="text-sm font-semibold text-slate-700 sm:col-span-3"><%= t(key) %></label>
            <div class="sm:col-span-9"><input id="report-<%= field %>" type="date" required name="<%= field %>" value="<%= value %>" class="h-10 w-full rounded-lg border border-slate-300 bg-white px-3 text-sm"></div>
          </div>
        <% } %>
        <% if (user.isAdmin || filters.canFilterAllBranches) { %>
          <%- include('../base/partials/report-multi-select',{name:'branch_ids',labelKey:'branches',selected:filters.branchIds,entries:options.branches}) %>
        <% } %>
        <%- include('../base/partials/report-multi-select',{name:'stock_types',labelKey:'item_type',selected:filters.stockTypes,entries:stockEntries}) %>
        <%- include('../base/partials/report-multi-select',{name:'approval_statuses',labelKey:'status',selected:filters.statuses,entries:[{id:'APPROVED',labelKey:'approved'},{id:'PENDING',labelKey:'pending'},{id:'REJECTED',labelKey:'rejected'}]}) %>
        <%- include('../base/partials/report-multi-select',{name:'reason_ids',labelKey:'reason',selected:filters.reasonIds,entries:options.reasons}) %>
        <%- include('../base/partials/report-multi-select',{name:'department_ids',labelKey:'departments',selected:[...filters.departmentIds,...(filters.includeUnassignedDepartment ? ['__UNASSIGNED__'] : [])],entries:departmentEntries}) %>
        <%- include('../base/partials/report-multi-select',{name:'voucher_ids',labelKey:'vouchers',selected:filters.voucherIds,entries:options.vouchers}) %>
        <%- include('../base/partials/report-multi-select',{name:'article_ids',labelKey:'articles',selected:filters.articleIds,entries:options.articles}) %>
        <div class="grid grid-cols-1 items-start gap-1.5 sm:grid-cols-12">
          <div class="sm:col-span-3"></div><div class="sm:col-span-9 flex flex-wrap gap-2">
            <button type="submit" class="inline-flex items-center rounded-xl bg-accent px-3 py-1.5 max-lg:py-2.5 text-xs font-semibold uppercase tracking-widest text-white shadow-sm"><%= t('load') %></button>
            <a href="<%= reportPath %>" class="inline-flex items-center rounded-xl border border-slate-300 bg-white px-3 py-1.5 max-lg:py-2.5 text-xs font-semibold uppercase tracking-widest text-slate-700"><%= t('cancel') %></a>
          </div>
        </div>
      </div>
    </form>
  </section>
  <section class="rounded-2xl border border-slate-200 bg-white p-3 shadow-sm" data-print-area>
    <div class="flex flex-col gap-3 border-b border-slate-200 px-2 py-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="text-sm font-semibold text-slate-700"><%= t('stock_count_details_report') %></div>
      <div class="flex flex-wrap items-center gap-2">
        <% for (const action of ['download','print']) { %>
          <button type="button" <%- action === 'download' ? 'data-download-button' : 'data-print-button' %> <%= rows.length ? '' : 'disabled' %> class="cursor-pointer rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-600 disabled:opacity-40"><%= t(action) %></button>
        <% } %>
        <%- include('../base/partials/table-controls',{t,showStatus:false}) %>
      </div>
    </div>
    <p class="mt-3 text-sm text-slate-600"><%= t('stock_count_details_help') %></p>
    <% if (!filters.reportLoaded || !rows.length) { %>
      <div class="mt-4 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-10 text-center text-2xl font-display text-slate-500"><%= t(filters.reportLoaded ? 'no_entries' : 'load_report_to_view') %></div>
    <% } else { %>
      <p class="mt-3 text-sm text-slate-700"><%= t('vouchers') %>: <%= reportData.totals.vouchers %> · <%= t('lines') %>: <%= reportData.totals.lines %> · <%= t('pending') %>: <%= reportData.totals.pending %></p>
      <div class="relative mt-4 overflow-x-auto rounded-2xl border border-slate-200">
        <table class="min-w-330 w-full text-sm tabular-nums" data-table data-report-table>
          <thead class="bg-slate-100 text-slate-700"><tr>
            <% columns.forEach(([key,label]) => { %><th class="whitespace-nowrap px-3 py-2 text-start text-xs font-semibold uppercase tracking-[0.08em]" data-sort-key="<%= key %>"><%= t(label) %></th><% }) %>
          </tr></thead>
          <tbody class="divide-y divide-slate-100" data-table-body>
            <% rows.forEach(row => { %>
              <tr class="odd:bg-slate-50 even:bg-white hover:bg-slate-100" data-row data-active="true">
                <% columns.forEach(([key]) => { %>
                  <td class="whitespace-nowrap px-3 py-2">
                    <% if (key === 'voucherNo' && row.voucherUrl) { %><a href="<%= row.voucherUrl %>" class="font-semibold text-accent underline"><%= row.voucherNo %></a>
                    <% } else if (key === 'status') { %><%= t(String(row.status).toLowerCase()) %>
                    <% } else if (key === 'sourceKey') { %><%= t(row.sourceKey) %>
                    <% } else if (['systemQty','countedQty','difference','postedIn','postedOut'].includes(key)) { %><%= n(row[key]) %>
                    <% } else if (key === 'unitCost') { %><%= row.unitCost == null ? '-' : formatNumberDisplay(row.unitCost,{decimals:6,fallback:'0'}) %>
                    <% } else if (['increaseValue','decreaseValue','netValue'].includes(key)) { %><%= m(row[key]) %>
                    <% } else if (key === 'notes') { %>
                      <span><%= row.notes || '-' %></span>
                      <% if (row.sharedPosting) { %><span class="block text-xs text-slate-500"><%= t('stock_count_shared_posting') %></span><% } %>
                      <% if (row.systemQty == null || row.countedQty == null) { %><span class="block text-xs text-amber-700"><%= t('stock_count_missing_snapshot') %></span><% } %>
                      <% if (row.postingMissing) { %><span class="block text-xs text-amber-700"><%= t('stock_count_missing_posting') %></span><% } %>
                    <% } else { %><%= row[key] || '-' %><% } %>
                  </td>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <%- include('../base/partials/table-footer',{t}) %>
      <div class="mt-4 rounded-xl border border-slate-200 bg-slate-50 p-3 text-sm text-slate-700">
        <div class="font-semibold"><%= t('stock_count_unit_totals') %></div>
        <% reportData.unitTotals.forEach(total => { %>
          <p><%= total.stockType %> · <%= total.unit %>: <%= t('stock_count_posted_in') %> <%= n(total.postedIn) %> · <%= t('stock_count_posted_out') %> <%= n(total.postedOut) %></p>
        <% }) %>
        <% if (costs) { %><p class="mt-2 font-semibold"><%= t('stock_count_increase_value') %>: <%= m(reportData.totals.increaseValue) %> · <%= t('stock_count_decrease_value') %>: <%= m(reportData.totals.decreaseValue) %> · <%= t('stock_count_net_value') %>: <%= m(reportData.totals.netValue) %></p><% } %>
      </div>
    <% } %>
  </section>
</div>
