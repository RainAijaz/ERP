<% if (reportData.payrollContext?.canClose && filters.reportLoaded) { %>
<dialog data-payroll-dialog class="m-auto max-h-[90vh] w-full max-w-3xl overflow-y-auto rounded-2xl border border-slate-200 bg-white p-0 text-slate-700 shadow-xl backdrop:bg-slate-900/40">
  <div class="p-5 sm:p-6">
    <div class="flex items-start justify-between gap-3">
      <h2 class="text-lg font-semibold" data-payroll-title><%= t('payroll_close') %></h2>
      <button type="button" class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200" data-payroll-close aria-label="<%= t('close') %>">×</button>
    </div>
    <p class="mt-2 text-sm font-semibold"><%= payrollName %></p>
    <p class="mt-2 text-xs text-slate-500"><%= t('payroll_global_scope_help') %></p>
    <p class="mt-2 text-xs text-slate-500"><%= t('payroll_payment_help') %></p>
    <p class="mt-3 text-sm text-slate-600" role="status" data-payroll-notice></p>
    <form data-payroll-form class="mt-4 space-y-3">
      <input type="hidden" name="worker_key" value="<%= reportData.payrollContext.kind %>:<%= reportData.payrollContext.entityId %>">
      <% ['period_from', 'period_to'].forEach(key => { %>
        <label class="block text-sm font-semibold"><span><%= t('salary_' + key) %></span>
          <input required type="date" min="1900-01-01" name="<%= key %>" class="mt-2 h-10 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm">
        </label>
      <% }) %>
      <% if (reportData.payrollContext.kind === 'employee') { %>
        <label class="block text-sm font-semibold"><span><%= t('salary_unpaid_days') %></span>
          <input type="number" name="unpaid_days" value="0" min="0" max="366" step="0.5" class="mt-2 h-10 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm">
        </label>
      <% } %>
      <p class="text-xs text-slate-500 md:col-span-2"><%= t('payroll_cycle_help') %></p>
      <div class="flex flex-wrap gap-2 md:col-span-2">
        <button type="submit" class="rounded-xl bg-accent px-4 py-2 text-sm font-semibold text-white"><%= t('preview') %></button>
        <button type="button" data-payroll-finalize disabled class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-semibold disabled:opacity-50"><%= t('salary_finalize') %></button>
      </div>
    </form>
    <section data-payroll-history hidden class="mt-4">
      <p class="text-xs text-slate-500"><%= t('payroll_history_help') %></p>
      <div class="mt-3 overflow-x-auto rounded-xl border border-slate-200">
        <table class="min-w-[560px] w-full text-sm" data-report-table>
          <thead class="bg-slate-100"><tr>
            <% ['salary_period_from','salary_period_to','salary_total_payable','actions'].forEach(key => { %><th class="whitespace-nowrap px-3 py-2 text-start"><%= t(key) %></th><% }) %>
          </tr></thead>
          <tbody data-payroll-runs></tbody>
        </table>
      </div>
      <button type="button" data-payroll-more hidden class="mt-3 rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-semibold"><%= t('payroll_more_periods') %></button>
    </section>
    <section data-payroll-preview hidden class="mt-4 space-y-3">
      <h3 class="text-sm font-semibold" data-payroll-preview-heading></h3>
      <p class="text-xs text-slate-500" data-payroll-preview-period></p>
      <div class="overflow-x-auto rounded-xl border border-slate-200">
        <table class="min-w-full text-sm" data-report-table><tbody>
          <% ['guaranteed_salary','eligible_earnings','salary_adjustment','extra_earnings','period_earnings'].forEach(key => { %>
            <tr hidden data-payroll-guarantee class="border-b border-slate-100"><th class="px-3 py-2 text-start"><%= t('guarantee_' + key) %></th><td class="px-3 py-2 text-end" data-payroll-total="<%= key %>"></td></tr>
          <% }) %>
          <% ['opening_balance','total_credit','total_debit','absence_deduction','total_payable'].forEach(key => { %>
            <tr class="border-b border-slate-100"><th class="px-3 py-2 text-start"><%= t('salary_' + key) %></th><td class="px-3 py-2 text-end" data-payroll-total="<%= key %>"></td></tr>
          <% }) %>
        </tbody></table>
      </div>
      <div class="overflow-x-auto rounded-xl border border-slate-200">
        <table class="min-w-[480px] w-full text-sm" data-report-table><thead class="bg-slate-100"><tr>
          <% ['date','voucher_type','debit','credit'].forEach(key => { %><th class="px-3 py-2 text-start"><%= t(key) %></th><% }) %>
        </tr></thead><tbody data-payroll-lines></tbody></table>
      </div>
    </section>
  </div>
</dialog>
<script><%- include('./payroll-client.js') %></script>
<% } %>
