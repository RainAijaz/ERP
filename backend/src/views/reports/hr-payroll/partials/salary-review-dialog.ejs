<% if (reportData.salaryReviewContext && filters.reportLoaded) { %>
<dialog data-salary-review-dialog class="m-auto w-full max-w-md rounded-2xl border border-slate-200 bg-white p-0 text-slate-700 shadow-xl backdrop:bg-slate-900/40">
  <div class="p-5 sm:p-6">
    <div class="flex items-start justify-between gap-3">
      <h2 class="text-lg font-semibold"><%= t(reportData.salaryReviewContext.canManage ? 'salary_review_title' : 'salary_review_last') %></h2>
      <button type="button" class="inline-flex h-8 w-8 items-center justify-center rounded-lg border border-slate-200" data-salary-review-close aria-label="<%= t('close') %>">×</button>
    </div>
    <p class="mt-2 text-sm text-slate-500" data-salary-review-name></p>
    <dl class="mt-4 space-y-2 rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs">
      <div class="flex flex-wrap justify-between gap-2"><dt><%= t('salary_review_through') %></dt><dd data-salary-review-last></dd></div>
      <div class="flex flex-wrap justify-between gap-2"><dt><%= t('salary_review_checked_by') %></dt><dd data-salary-review-by></dd></div>
      <div class="flex flex-wrap justify-between gap-2"><dt><%= t('salary_review_on') %></dt><dd data-salary-review-on></dd></div>
    </dl>
    <form data-salary-review-form class="mt-4 space-y-3">
      <% if (reportData.salaryReviewContext.canManage) { %>
        <label class="block text-sm font-semibold" for="salary-review-through"><%= t('salary_review_through') %></label>
        <input id="salary-review-through" name="checked_through" type="date" required min="1900-01-01" class="h-10 w-full rounded-xl border border-slate-300 bg-white px-3 text-sm">
        <p class="text-xs text-slate-500"><%= t('salary_review_date_help') %></p>
      <% } %>
      <p class="text-xs text-slate-500"><%= t('salary_review_scope_help') %></p>
      <p class="hidden text-sm text-red-700" role="alert" data-salary-review-error></p>
      <div class="flex flex-wrap justify-end gap-2 border-t border-slate-200 pt-4">
        <button type="button" class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm font-semibold" data-salary-review-close><%= t('cancel') %></button>
        <% if (reportData.salaryReviewContext.canManage) { %><button type="submit" class="rounded-xl bg-accent px-3 py-2 text-sm font-semibold text-white disabled:opacity-50" data-salary-review-save><%= t('salary_review_save') %></button><% } %>
      </div>
    </form>
  </div>
</dialog>
<script><%- include('./salary-review-client.js') %></script>
<% } %>
