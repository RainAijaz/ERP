<%
  const supplierGroupIds = filters?.supplierGroupIds || [];
  const embedded = typeof supplierTypeEmbedded !== 'undefined' && supplierTypeEmbedded;
  const roundedClass = embedded || (typeof supplierTypeRounded !== 'undefined' && supplierTypeRounded === 'xl') ? 'rounded-xl' : 'rounded-lg';
%>
<% if (!embedded) { %>
<div class="grid grid-cols-1 items-start gap-1.5 sm:grid-cols-12" data-supplier-type-filter>
<% } %>
  <label for="supplier-group-filter" class="<%= embedded ? 'text-xs font-semibold uppercase tracking-[0.08em] text-slate-700' : 'text-sm font-semibold text-slate-700 sm:col-span-3' %>" title="<%= t('supplier_type_help') %>"><%= t('supplier_type') %></label>
  <div class="<%= embedded ? 'relative' : 'sm:col-span-9' %>">
    <select id="supplier-group-filter" name="supplier_group_ids" multiple data-supplier-group-filter data-searchable-select="true" data-searchable-variant="unified" data-all-multi-select="true" class="h-10 w-full <%= roundedClass %> border border-slate-300 bg-white px-3 text-sm" aria-invalid="<%= filters?.invalidSupplierGroupFilter ? 'true' : 'false' %>" <%- filters?.invalidSupplierGroupFilter ? 'aria-describedby="supplier-group-error"' : '' %>>
      <option value="__ALL__" <%= !supplierGroupIds.length ? 'selected' : '' %>><%= t('all') %></option>
      <% (options?.supplierGroups || []).forEach((group) => { %>
        <option value="<%= group.id %>" <%= supplierGroupIds.includes(Number(group.id)) ? 'selected' : '' %>><%= group.name %></option>
      <% }) %>
    </select>
    <% if (filters?.invalidSupplierGroupFilter) { %>
      <p id="supplier-group-error" role="alert" class="mt-2 rounded-xl border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-semibold text-amber-800"><%= t('invalid_supplier_type_selection') %></p>
    <% } %>
  </div>
<% if (!embedded) { %>
</div>
<% } %>
<script><%- include('supplier-type-filter.js') %></script>
