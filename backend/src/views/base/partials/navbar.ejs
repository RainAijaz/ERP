<%
  const isUrduLocale = String(locale || "en").trim().toLowerCase() === "ur";
  const signedInName = isUrduLocale
    ? user?.name_ur || user?.name || user?.username || "-"
    : user?.name || user?.username || "-";
%>
<div class="contents text-xs text-muted">
  <div class="flex min-w-0 items-center gap-2 px-1 py-2">
    <span class="hidden text-xs text-muted xl:inline"><%= t("signed_in_as") %></span>
    <span class="max-w-40 truncate font-semibold text-slate-800" title="<%= signedInName %>"><%= signedInName %></span>
  </div>
  <form method="get" action="/" class="flex items-center">
    <label for="branch-select" class="sr-only"><%= t("branch") %></label>
    <div class="flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2">
      <span class="text-xs text-muted"><%= t("branch") %></span>
      <% if (branchScope && branchScope.length > 1) { %>
        <select
          id="branch-select"
          name="branch_id"
          class="w-14 max-w-22 flex-none truncate border-0 bg-transparent py-0 pl-1 pr-4 text-sm font-semibold text-slate-700"
          data-searchable-select="true"
          data-searchable-variant="navbar"
          onchange="if (!event.isTrusted) return; if (window.__syncBranchSelection) window.__syncBranchSelection(this.value); if (window.__navigateWithBranch) { window.__navigateWithBranch(this.value); } else { this.form.submit(); }"
        >
        <% if (branchOptions && branchOptions.length) { %>
            <% branchOptions.forEach(function(branch) { %>
              <option value="<%= branch.id %>" <%= Number(branch.id) === branchId ? "selected" : "" %>>
                <%= branch.code && branch.name && branch.code !== branch.name ? branch.code + " - " : "" %><%= branch.name || branch.code || branch.id %>
              </option>
            <% }) %>
          <% } else { %>
            <% branchScope.forEach(function(bid) { %>
              <option value="<%= bid %>" <%= bid === branchId ? "selected" : "" %>>
                <%= t("branch") %> <%= bid %>
              </option>
            <% }) %>
          <% } %>
        </select>
      <% } else { %>
        <span class="text-xs font-semibold text-slate-800"><%= branchName || branchId || "N/A" %></span>
      <% } %>
    </div>
  </form>
  <form method="post" action="/auth/logout" class="flex items-center">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <button type="submit" class="rounded-lg px-3 py-2 text-xs font-medium text-slate-600 transition hover:bg-slate-50 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/30">
      <%= t("logout") %>
    </button>
  </form>
  <div class="flex items-center gap-1 rounded-lg border border-slate-200 bg-slate-50 p-1 text-xs" role="group" aria-label="<%= t('language') %>">
    <a class="rounded-md px-2.5 py-1 font-medium text-slate-600 transition hover:text-accent <%= !isUrduLocale ? 'bg-white text-accent shadow-sm' : '' %>" href="?lang=en" <%- !isUrduLocale ? 'aria-current="true"' : '' %>><%= t("english") %></a>
    <a class="rounded-md px-2.5 py-1 font-medium text-slate-600 transition hover:text-accent <%= isUrduLocale ? 'bg-white text-accent shadow-sm' : '' %>" href="?lang=ur" <%- isUrduLocale ? 'aria-current="true"' : '' %>><%= t("urdu") %></a>
  </div>
</div>
