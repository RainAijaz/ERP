<%
  const isUrduLocale = String(locale || "en").trim().toLowerCase() === "ur";
  const signedInName = isUrduLocale
    ? user?.name_ur || user?.name || user?.username || "-"
    : user?.name || user?.username || "-";
  const signedInInitials = String(signedInName).trim().split(/\s+/).slice(0, 2)
    .map((part) => Array.from(part)[0] || "").join("").toLocaleUpperCase();
%>
<div class="contents text-xs text-muted">
  <div data-workspace-account class="flex min-w-0 items-center gap-2 px-2 py-1" aria-label="<%= t('signed_in_as') %>">
    <span aria-hidden="true" class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/10 font-semibold text-white"><%= signedInInitials %></span>
    <span class="max-w-40 truncate font-medium text-white" title="<%= signedInName %>"><%= signedInName %></span>
  </div>
  <form data-workspace-branch method="get" action="/" class="flex items-center">
    <label for="branch-select" class="sr-only"><%= t("branch") %></label>
    <div data-workspace-control class="flex min-h-9 items-center gap-2 rounded-lg border border-white/20 px-3 py-1">
      <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M9 21v-4h6v4M8 7h1m6 0h1m-8 4h1m6 0h1"/></svg>
      <% if (branchScope && branchScope.length > 1) { %>
        <select
          id="branch-select"
          name="branch_id"
          class="w-24 max-w-36 flex-none truncate border-0 bg-transparent py-0 pl-1 pr-4 text-sm font-semibold text-slate-700 sm:w-36"
          data-searchable-select="true"
          data-searchable-variant="navbar"
          onchange="if (!event.isTrusted) return; if (window.__syncBranchSelection) window.__syncBranchSelection(this.value); if (window.__navigateWithBranch) { window.__navigateWithBranch(this.value); } else { this.form.submit(); }"
        >
        <% if (branchOptions && branchOptions.length) { %>
            <% branchOptions.forEach(function(branch) { %>
              <option value="<%= branch.id %>" <%= Number(branch.id) === branchId ? "selected" : "" %>>
                <%= branch.code && branch.name && branch.code !== branch.name ? branch.code + " - " : "" %><%= branch.name || branch.code || branch.id %>
              </option>
            <% }) %>
          <% } else { %>
            <% branchScope.forEach(function(bid) { %>
              <option value="<%= bid %>" <%= bid === branchId ? "selected" : "" %>>
                <%= t("branch") %> <%= bid %>
              </option>
            <% }) %>
          <% } %>
        </select>
      <% } else { %>
        <span class="text-xs font-semibold text-white"><%= branchName || branchId || "N/A" %></span>
      <% } %>
    </div>
  </form>
  <form data-workspace-logout method="post" action="/auth/logout" class="flex items-center">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <button data-workspace-control type="submit" class="inline-flex min-h-9 items-center rounded-lg px-3 py-1 text-xs font-medium text-white transition hover:bg-white/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/50">
      <%= t("logout") %>
    </button>
  </form>
  <div data-workspace-language class="flex min-h-9 items-center gap-1 rounded-lg p-1 text-xs" role="group" aria-label="<%= t('language') %>">
    <a class="rounded-md px-2.5 py-0.5 font-medium text-white/80 transition hover:bg-white/10 hover:text-white <%= !isUrduLocale ? 'bg-white/10 text-white' : '' %>" href="?lang=en" <%- !isUrduLocale ? 'aria-current="true"' : '' %>><%= t("english") %></a>
    <a class="rounded-md px-2.5 py-0.5 font-medium text-white/80 transition hover:bg-white/10 hover:text-white <%= isUrduLocale ? 'bg-white/10 text-white' : '' %>" href="?lang=ur" <%- isUrduLocale ? 'aria-current="true"' : '' %>><%= t("urdu") %></a>
  </div>
</div>
