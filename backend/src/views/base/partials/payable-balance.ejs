<%
  // Only the display direction changes; report amounts retain their ledger sign.
  const payableDisplayBalance = Number(balance || 0) *
    (typeof balanceOrientation !== 'undefined' && balanceOrientation === 'receivable' ? -1 : 1);
%>
<span class="inline-flex items-center gap-2"><span class="tabular-nums"><%= formatNumber(Math.abs(payableDisplayBalance), 2) %></span><% if (payableDisplayBalance > 0) { %><span class="rounded-full bg-amber-50 px-2 py-1 text-xs font-semibold text-amber-800"><%= t('payable') %></span><% } else if (payableDisplayBalance < 0) { %><span class="rounded-full bg-emerald-50 px-2 py-1 text-xs font-semibold text-emerald-800"><%= t('receivable') %></span><% } %></span>
