<% const physicalCounts = reportData && reportData.physicalCounts; %>
<% if (physicalCounts) { %>
  <% if (physicalCounts.unavailable) { %>
    <div class="mt-3 max-w-xl rounded-xl border border-slate-200 bg-slate-50 p-3 text-xs text-slate-600" role="status"><%= t("physical_counts_unavailable") %></div>
  <% } else if (physicalCounts.rows.length) { %>
    <details class="mt-3" data-physical-count-card>
      <summary class="flex w-full max-w-xl cursor-pointer list-none flex-wrap items-center justify-between gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
        <span class="block">
          <span class="flex items-center gap-2 text-xs font-semibold text-slate-600">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 5H6a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-3M9 3h6v4H9zM9 14l2 2 4-4"/></svg>
            <%= t("physical_counts") %>
          </span>
          <span class="mt-1 block text-base font-semibold text-slate-900">
            <% if (physicalCounts.branchCount > 1) { %>
              <%= t("physical_count_branches_selected").replace("{count}", String(physicalCounts.branchCount)) %>
            <% } else if (physicalCounts.rows.length === 1) { %>
              <%= physicalCounts.rows[0].countDate ? formatDateDisplay(physicalCounts.rows[0].countDate, "-") : t("physical_count_not_recorded") %>
            <% } else { %>
              <%= physicalCounts.branchName %>
            <% } %>
          </span>
          <span class="mt-1 block text-xs text-slate-500"><%= t("physical_count_as_of").replace("{date}", formatDateDisplay(physicalCounts.asOfDate, "-")) %></span>
        </span>
        <span class="inline-flex items-center gap-2 text-xs font-semibold text-slate-700"><%= t("physical_count_view_latest") %><span aria-hidden="true">⌄</span></span>
      </summary>
      <div class="mt-3 overflow-x-auto rounded-xl border border-slate-200" data-physical-count-details>
        <table class="min-w-[640px] w-full text-xs tabular-nums" data-mobile-report>
          <thead class="bg-slate-100 text-slate-600"><tr>
            <th class="px-3 py-2 text-start"><%= t("branch") %></th>
            <th class="px-3 py-2 text-start"><%= t("product_group") %></th>
            <th class="px-3 py-2 text-start"><%= t("stock_type") %></th>
            <th class="px-3 py-2 text-start"><%= t("physical_count_last_counted") %></th>
            <th class="px-3 py-2 text-start"><%= t("physical_count_articles") %></th>
            <th class="px-3 py-2 text-start"><%= t("voucher_no") %></th>
          </tr></thead>
          <tbody class="divide-y divide-slate-100">
            <% physicalCounts.rows.forEach((count) => { %>
              <tr>
                <td class="px-3 py-2"><%= count.branchName %></td>
                <td class="px-3 py-2"><%= count.groupName || t("physical_count_ungrouped") %><% if (count.partial) { %><span class="mt-1 block text-slate-500"><%= t("physical_count_partial") %></span><% } %></td>
                <td class="px-3 py-2"><%= t(count.stockType === "RM" ? "raw_materials" : count.stockType === "SFG" ? "semi_finished" : "finished") %></td>
                <td class="px-3 py-2 whitespace-nowrap">
                  <% if (count.countDate && count.voucherUrl) { %><a class="font-semibold text-slate-700 underline" href="<%= count.voucherUrl %>" target="_blank" rel="noopener noreferrer"><%= formatDateDisplay(count.countDate, "-") %></a>
                  <% } else { %><%= count.countDate ? formatDateDisplay(count.countDate, "-") : t("physical_count_not_recorded") %><% } %>
                </td>
                <td class="px-3 py-2"><%= count.countDate ? count.countedArticles : "—" %></td>
                <td class="px-3 py-2"><%= count.voucherNo || "—" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="mt-2 text-xs text-slate-500"><%= t("physical_count_latest_hint") %></p>
    </details>
  <% } %>
<% } %>
