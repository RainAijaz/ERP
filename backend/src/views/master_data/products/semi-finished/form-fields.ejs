<label class="block text-sm font-semibold text-slate-600">
  <span><%= t("name") %></span>
  <input class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-accent/30" type="text" name="name" data-field="name" placeholder="<%= t('name') %>" required />
</label>

<label class="block text-sm font-semibold text-slate-600">
  <span><%= t("name_ur") %> <span class="text-rose-500">*</span></span>
  <input class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-accent/30" type="text" name="name_ur" data-field="name_ur" placeholder="<%= t('name_ur') %>" required />
</label>

<div class="grid gap-4 lg:grid-cols-2">
  <label class="block text-sm font-semibold text-slate-600">
    <span><%= t("sub_group") %> <span class="text-rose-500">*</span></span>
    <select
      class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-accent/30"
      name="subgroup_id"
      data-field="subgroup_id"
      data-searchable-select="true"
      data-searchable-variant="unified"
      required
    >
      <option value=""><%= t("select") %> <%= t("sub_group") %></option>
      <% subgroups.forEach(function(subgroup) { %>
        <option value="<%= subgroup.id %>"><%= locale === "ur" ? (subgroup.name_ur || subgroup.name) : subgroup.name %></option>
      <% }) %>
    </select>
  </label>

  <% const pairUom = (uoms && uoms[0]) ? uoms[0] : null; %>
  <label class="block text-sm font-semibold text-slate-600">
    <span><%= t("group") %> <span class="text-rose-500">*</span></span>
    <select class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-accent/30" name="group_id" data-field="group_id" data-searchable-select="true" data-searchable-variant="unified" required>
      <option value=""><%= t("select") %> <%= t("group") %></option>
      <% groups.forEach(function(group) { %>
        <option value="<%= group.id %>"><%= locale === "ur" ? (group.name_ur || group.name) : group.name %></option>
      <% }) %>
    </select>
  </label>
  <label class="block text-sm font-semibold text-slate-600 lg:col-span-2">
    <span><%= t("base_unit") %> <span class="text-rose-500">*</span></span>
    <select class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-accent/30" name="base_uom_id" data-field="base_uom_id" data-searchable-select="true" data-searchable-variant="unified" required>
      <% if (pairUom) { %>
        <option value="<%= pairUom.id %>" selected><%= pairUom.code %></option>
      <% } else { %>
        <option value=""><%= t("pair_uom_required")  %></option>
      <% } %>
    </select>
  </label>
</div>

<div class="rounded-xl border border-slate-200 bg-slate-50/70 px-4 py-3">
  <label class="flex items-start gap-3 text-sm font-semibold text-slate-600">
    <input
      type="checkbox"
      name="is_global_sfg"
      data-field="is_global_sfg"
      data-global-sfg-toggle
      value="true"
      class="mt-0.5 h-4 w-4 rounded border-slate-300"
    />
    <span>
      <%= t("global_sfg") %>
      <span class="mt-1 block text-xs font-normal text-slate-500"><%= t("global_sfg_help") %></span>
    </span>
  </label>
</div>

<label class="block text-sm font-semibold text-slate-600" data-usage-wrap>
  <span><%= t("usage") %></span>
  <select
    class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-accent/30 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-400"
    name="fg_ids"
    data-field="fg_ids"
    data-searchable-select="true"
    data-searchable-variant="unified"
    multiple
  >
    <% finished.forEach(function(item) { %>
      <option value="<%= item.id %>"><%= locale === "ur" ? (item.name_ur || item.name) : item.name %></option>
    <% }) %>
  </select>
  <p class="mt-1 text-xs text-slate-500" data-usage-help><%= t("usage_help") %></p>
</label>
