<%
  const initialValues = (typeof modalValues !== "undefined" && modalValues) ? modalValues : {};
  const hasCodeColumn = Array.isArray(page.columns) && page.columns.some((column) => column.key === "code");
%>
<% if (hasCodeColumn) { %>
  <label class="block text-sm font-semibold text-slate-600" data-hide-on-create="true">
    <span><%= t("code") %></span>
    <input
      class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-100 px-4 py-3 text-sm text-slate-600 shadow-sm cursor-not-allowed"
      type="text"
      data-field="code"
      value="<%= initialValues.code || '' %>"
      readonly
      disabled
    />
  </label>
<% } %>
<% page.fields.forEach(function(field) { %>
        <% const hideOnCreate = page.titleKey === "parties" && (field.name === "credit_allowed" || field.name === "credit_limit"); %>
        <% const supplierHiddenClass = ""; %>
  <% const visibilityAttrs = [hideOnCreate ? 'data-hide-on-create="true"' : ""].filter(Boolean).join(" "); %>
        <% /* adminOnly is ignored for modal fields; all users see all fields except those hidden by other logic */ %>
        <% if (field.name === "code") { return; } %>
        <% if (field.type === "checkbox") { %>
          <label class="flex flex-1 items-start gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-600<%= supplierHiddenClass %>" <%- visibilityAttrs %>>
            <input class="mt-0.5 h-4 w-4 rounded border-slate-300 text-accent focus:ring-accent/40" type="checkbox" name="<%= field.name %>" data-field="<%= field.name %>" />
            <span class="flex flex-col gap-1">
              <span><%= t(field.label) %></span>
              <% if (field.helpText) { %>
                <span class="text-xs font-normal text-slate-500"><%= t(field.helpText) %></span>
              <% } %>
            </span>
          </label>
        <% } else if (field.type === "select") { %>
          <% const quickAddHref =
            (page.titleKey === "parties" && field.name === "group_id") ? "/master-data/basic-info/party-groups" :
            (page.titleKey === "parties" && field.name === "city_id") ? "/master-data/basic-info/cities" :
            (page.titleKey === "accounts" && field.name === "subgroup_id") ? "/master-data/basic-info/account-groups" :
            ""; %>
          <label class="block text-sm font-semibold text-slate-600<%= supplierHiddenClass %>" <%- visibilityAttrs %>>
            <span class="flex items-center justify-between gap-2">
              <span><%= t(field.label) %></span>
              <% if (quickAddHref) { %>
                <a class="text-[10px] font-semibold uppercase tracking-[0.18em] text-accent transition hover:text-accent/80" href="<%= quickAddHref %>" target="_blank" rel="noopener">
                  + <%= t("add") %> <%= t(field.label) %>
                </a>
              <% } %>
            </span>
            <% if (field.helpText) { %>
              <span class="mt-1 block text-xs font-normal text-slate-500"><%= t(field.helpText) %></span>
            <% } %>
            <select
              class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-accent/30"
              name="<%= field.name %>"
              data-field="<%= field.name %>"
              <%= field.required ? "required" : "" %>
            >
              <option value=""><%= t("select") %></option>
            <% (field.options || []).forEach(function(option) { %>
              <option
                value="<%= option.value %>"
                <%= field.name === "group_id" && option.partyType ? "data-party-type=\"" + option.partyType + "\"" : "" %>
              >
                <%= field.optionsQuery ? option.label : t(option.label) %>
              </option>
            <% }) %>
            </select>
          </label>
        <% } else if (field.type === "textarea") { %>
          <label class="block text-sm font-semibold text-slate-600<%= supplierHiddenClass %>" <%- visibilityAttrs %>>
            <span><%= t(field.label) %></span>
            <% if (field.helpText) { %>
              <span class="mt-1 block text-xs font-normal text-slate-500"><%= t(field.helpText) %></span>
            <% } %>
            <textarea
              class="mt-2 w-full min-h-[96px] resize-none rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-accent/30"
              name="<%= field.name %>"
              data-field="<%= field.name %>"
              placeholder="<%= field.placeholder ? t(field.placeholder) : "" %>"
              rows="3"
              <%= field.required ? "required" : "" %>
              data-auto-resize="true"
            ></textarea>
          </label>
        <% } else if (field.type === "number") { %>
          <label class="block text-sm font-semibold text-slate-600<%= supplierHiddenClass %>" <%- visibilityAttrs %>>
            <span><%= t(field.label) %></span>
            <% if (field.helpText) { %>
              <span class="mt-1 block text-xs font-normal text-slate-500"><%= t(field.helpText) %></span>
            <% } %>
            <input
              class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-accent/30"
              type="number"
              name="<%= field.name %>"
              placeholder="<%= field.placeholder ? t(field.placeholder) : "" %>"
              data-field="<%= field.name %>"
              <%= field.step ? "step=\"" + field.step + "\"" : "" %>
              <%= field.min ? "min=\"" + field.min + "\"" : "" %>
              <%= field.required ? "required" : "" %>
            />
          </label>
        <% } else if (field.type === "multi-select") { %>
          <% const hasAllOption = (field.options || []).some(function(option) {
               const value = String(option && option.value ? option.value : "").trim().toLowerCase();
               return value === "all" || value === "__all__";
             }); %>
          <label class="block text-sm font-semibold text-slate-600<%= supplierHiddenClass %>" <%- visibilityAttrs %>>
            <span><%= t(field.label) %></span>
            <% if (field.helpText) { %>
              <span class="mt-1 block text-xs font-normal text-slate-500"><%= t(field.helpText) %></span>
            <% } %>
            <select
              class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-accent/30"
              name="<%= field.name %>"
              data-field="<%= field.name %>"
              data-searchable-select="true"
              data-searchable-variant="unified"
              <%= hasAllOption ? 'data-all-multi-select="true"' : "" %>
              multiple
              <%= field.required ? "data-required=\"true\"" : "" %>
            >
              <% (field.options || []).forEach(function(option) { %>
                <option value="<%= option.value %>"><%= field.optionsQuery ? option.label : t(option.label) %></option>
              <% }) %>
            </select>
          </label>
        <% } else if (field.type === "multi-checkbox") { %>
          <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-600<%= supplierHiddenClass %>" <%- visibilityAttrs %>>
            <div class="flex flex-col gap-1">
              <span><%= t(field.label) %></span>
              <% if (field.helpText) { %>
                <span class="text-xs font-normal text-slate-500"><%= t(field.helpText) %></span>
              <% } %>
            </div>
            <div class="mt-3 flex flex-wrap gap-3">
              <% (field.options || []).forEach(function(option) { %>
                <label class="flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-2 text-xs font-semibold uppercase tracking-[0.12em] text-slate-600">
                  <input
                    class="h-4 w-4 rounded border-slate-300 text-accent focus:ring-accent/40"
                    type="checkbox"
                    name="<%= field.name %>"
                    value="<%= option.value %>"
                    data-field="<%= field.name %>"
                    data-multi="true"
                  />
                  <span><%= t(option.label) %></span>
                </label>
              <% }) %>
            </div>
          </div>
        <% } else { %>
          <label class="block text-sm font-semibold text-slate-600<%= supplierHiddenClass %>" <%- visibilityAttrs %>>
            <span><%= t(field.label) %></span>
            <% if (page.titleKey === "units" && field.name === "code") { %>
              <span class="mt-1 block text-xs font-normal text-slate-500"><%= t("help_unit_code") %></span>
            <% } %>
            <% if (page.titleKey === "units" && field.name === "name") { %>
              <span class="mt-1 block text-xs font-normal text-slate-500"><%= t("help_unit_name") %></span>
            <% } %>
            <% if (field.helpText) { %>
              <span class="mt-1 block text-xs font-normal text-slate-500"><%= t(field.helpText) %></span>
            <% } %>
            <input
              class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-accent/30"
              type="text"
              name="<%= field.name %>"
              placeholder="<%= field.placeholder ? t(field.placeholder) : "" %>"
              data-field="<%= field.name %>"
              <%= field.required ? "required" : "" %>
              <%= field.name === "name_ur" ? "autocomplete=\"off\"" : "" %>
            />
          </label>
        <% } %>
      <% }) %>
<% if (page.titleKey === "parties") { %>
  <%
    /* Opening balance is NOT a column on erp.parties — balances are always derived
       from erp.gl_entry. These three inputs are lifted out of the body by the route
       into an `_opening_balance` meta key and posted as a Journal Voucher once the
       party exists. Rendered outside the page.fields loop so nothing tries to
       persist them, and create-only because an existing party's balance is changed
       by posting a voucher, not by editing the party. */
  %>
  <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3" data-hide-on-edit="true" data-opening-balance-group>
    <div class="flex flex-col gap-1">
      <span class="text-sm font-semibold text-slate-600"><%= t("opening_balance") %></span>
      <span class="text-xs font-normal text-slate-500"><%= t("help_opening_balance") %></span>
    </div>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      <label class="block text-sm font-semibold text-slate-600">
        <span><%= t("opening_balance_amount") %></span>
        <input
          class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-accent/30"
          type="number"
          name="opening_balance"
          data-field="opening_balance"
          step="0.01"
          min="0"
          placeholder="0.00"
        />
      </label>
      <label class="block text-sm font-semibold text-slate-600">
        <span><%= t("opening_balance_direction") %></span>
        <select
          class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-accent/30"
          name="opening_balance_direction"
          data-field="opening_balance_direction"
        >
          <option value="DR"><%= t("opening_balance_they_owe") %></option>
          <option value="CR"><%= t("opening_balance_we_owe") %></option>
        </select>
      </label>
      <label class="block text-sm font-semibold text-slate-600">
        <span><%= t("opening_balance_date") %></span>
        <input
          class="mt-2 w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-accent/30"
          type="date"
          name="opening_balance_date"
          data-field="opening_balance_date"
        />
      </label>
    </div>
  </div>
  <script>
    (function initPartyOpeningBalance() {
      const bind = (root) => {
        const group = root.querySelector("[data-opening-balance-group]");
        const partyType = root.querySelector('[data-field="party_type"]');
        if (!group || !partyType) return;
        const direction = group.querySelector('[data-field="opening_balance_direction"]');
        const amount = group.querySelector('[data-field="opening_balance"]');
        const sync = () => {
          // OTHER parties are neither bought from nor sold to, so they have no
          // AR/AP control account to post an opening balance against.
          const isOther = String(partyType.value || "").toUpperCase() === "OTHER";
          group.classList.toggle("hidden", isOther);
          group.querySelectorAll("[data-field]").forEach((control) => {
            control.disabled = isOther;
          });
          if (isOther && amount) amount.value = "";
          // Default the side to whichever way the balance normally runs; the user
          // can still flip it for an advance or a credit note.
          if (direction && !direction.dataset.touched) {
            direction.value =
              String(partyType.value || "").toUpperCase() === "SUPPLIER" ? "CR" : "DR";
          }
        };
        if (direction) {
          direction.addEventListener("change", () => {
            direction.dataset.touched = "1";
          });
        }
        partyType.addEventListener("change", sync);
        sync();
      };
      document.querySelectorAll("form").forEach(bind);
    })();
  </script>
<% } %>

