<%
  const canCreateBom = can("SCREEN", "master_data.bom", "create");
  const canNavigateBom = can("SCREEN", "master_data.bom", "navigate");
  const canSubmitBomRequest = !canCreateBom && canNavigateBom;
  const selectedLifecycle = String(filters?.lifecycle || "all").toLowerCase();
  const selectedWorkflow = String(filters?.workflow || "all").toUpperCase();
  const selectedBomType = String(filters?.bom_type || "all").toUpperCase();
  const selectedRows = String(filters?.rows || "25").toLowerCase();
  const activeSortKey = String(filters?.sort || "");
  const activeSortDir = String(filters?.dir || "desc").toLowerCase() === "asc" ? "asc" : "desc";
  const paging = (typeof pagination !== "undefined" && pagination)
    ? pagination
    : { page: 1, pageCount: 1, total: (rows || []).length, from: 0, to: 0 };
  // Prev/Next are plain links so a page stays shareable and the browser Back
  // button works. Everything except `page` is carried over verbatim.
  const buildPageUrl = (targetPage) => {
    const params = new URLSearchParams({
      rows: selectedRows,
      lifecycle: selectedLifecycle,
      workflow: selectedWorkflow === "ALL" ? "all" : selectedWorkflow,
      bom_type: selectedBomType === "ALL" ? "all" : selectedBomType,
    });
    if (filters?.q) params.set("q", String(filters.q));
    if (activeSortKey) {
      params.set("sort", activeSortKey);
      params.set("dir", activeSortDir);
    }
    params.set("page", String(targetPage));
    return `${basePath}?${params.toString()}`;
  };
  const lifecycleStatusOptions = [
    { value: "all", label: t("all") },
    { value: "active", label: t("active") },
    { value: "inactive", label: t("inactive") },
  ];
  const displayColumns = [
    { key: "bom_no", labelRaw: t("code") },
    { key: "item_name", labelRaw: t("article_name") },
    { key: "bom_stage", labelRaw: t("bom_stage") },
    { key: "version_no", labelRaw: t("version") },
    { key: "status", labelRaw: t("status") },
    { key: "bom_lifecycle", labelRaw: t("bom_lifecycle") },
    { key: "created_at", labelRaw: t("date"), sortType: "date" },
  ];
%>

<div class="mx-auto w-full max-w-7xl space-y-6">
  <section class="rounded-3xl border border-slate-200 bg-white/95 p-6 shadow-lg">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="space-y-1">
        <h1 class="text-2xl font-display text-ink"><%= t("bom_list")  %></h1>
        <p class="text-sm text-muted"><%= t("bom_description")  %></p>
      </div>
      <div class="flex flex-wrap gap-2">
        <% if (can("SCREEN", "master_data.bom.reports", "view")) { %>
          <a href="<%= basePath %>/reports" class="cursor-pointer rounded-full border border-slate-300 bg-white px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-700 shadow-sm transition hover:border-slate-400 hover:text-slate-900">
            <%= t("reports") %>
          </a>
        <% } %>
        <% if (canCreateBom) { %>
          <a href="<%= basePath %>/new" class="cursor-pointer rounded-full bg-slate-900 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-white shadow-sm transition hover:bg-slate-800">
            <%= t("add") %> <%= t("bom")  %>
          </a>
        <% } else if (canSubmitBomRequest) { %>
          <a href="<%= basePath %>/new" class="cursor-pointer rounded-full bg-slate-900 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-white shadow-sm transition hover:bg-slate-800">
            <%= t("submit_bom_request")  %>
          </a>
        <% } %>
      </div>
    </div>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white/95 shadow-md overflow-hidden">
    <form method="GET" action="<%= basePath %>" class="flex flex-col gap-3 border-b border-slate-200 px-5 py-4 sm:flex-row sm:items-center sm:justify-between" data-bom-filter-form>
      <div class="text-sm font-semibold text-slate-700"><%= t("list") %> <%= t("bom_list")  %></div>
      <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500">
        <%- include("../../base/partials/table-controls", {
          t,
          showStatus: true,
          showFilters: true,
          pageSizeName: "rows",
          selectedPageSize: selectedRows,
          statusName: "lifecycle",
          selectedStatus: selectedLifecycle,
          statusOptions: lifecycleStatusOptions,
          searchName: "q",
          searchValue: filters?.q || "",
        }) %>
        <input type="hidden" name="workflow" value="<%= selectedWorkflow === "ALL" ? "all" : selectedWorkflow %>" data-bom-workflow-input>
        <input type="hidden" name="bom_type" value="<%= selectedBomType === "ALL" ? "all" : selectedBomType %>" data-bom-type-input>
        <input type="hidden" name="sort" value="<%= activeSortKey %>" data-bom-sort-input>
        <input type="hidden" name="dir" value="<%= activeSortDir %>" data-bom-dir-input>
        <%/* No `page` field: changing search/rows/status/filters must land back on page 1. */%>
      </div>
    </form>

    <div class="overflow-x-auto bg-white">
      <table class="min-w-full text-sm" data-table>
        <thead class="bg-slate-50 text-xs font-semibold uppercase tracking-widest text-slate-500">
          <%- include("../../base/partials/table-header", { t, displayColumns, columnTooltips: {}, sortStartIndex: 1 }) %>
        </thead>
        <tbody class="divide-y divide-slate-100" data-table-body>
          <% if (!rows || rows.length === 0) { %>
            <%- include("../../base/partials/table-empty", { t, colspan: displayColumns.length + 2 }) %>
          <% } %>
          <% (rows || []).forEach(function(row, idx) { %>
            <tr class="hover:bg-amber-50/40 odd:bg-white even:bg-slate-50/40">
              <td class="px-4 py-3 text-slate-700"><%= Number(paging.from || 1) + idx %></td>
              <td class="px-4 py-3 text-slate-700"><%= row.bom_no %></td>
              <td class="px-4 py-3 text-slate-700"><%= row.item_name || "-" %></td>
              <td class="px-4 py-3 text-slate-700"><%= t((row.level || "").toLowerCase()) || row.level %></td>
              <td class="px-4 py-3 text-slate-700">V<%= row.version_no %></td>
              <td class="px-4 py-3">
                <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.12em] <%= row.status === 'APPROVED' ? 'border-sky-200 bg-sky-50 text-sky-700' : row.status === 'DRAFT' ? 'border-amber-200 bg-amber-50 text-amber-700' : row.status === 'PENDING' ? 'border-blue-200 bg-blue-50 text-blue-700' : 'border-rose-200 bg-rose-50 text-rose-700' %>">
                  <%= t((row.status || "").toLowerCase()) || row.status %>
                </span>
                <% if (Number(row.pending_approval_count || 0) > 0) { %>
                  <div class="mt-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-blue-600"><%= t("pending") %>: <%= row.pending_approval_count %></div>
                <% } %>
              </td>
              <td class="px-4 py-3">
                <% if (row.status === "APPROVED") { %>
                  <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.12em] <%= row.bom_is_active ? 'border-blue-200 bg-blue-50 text-blue-700' : 'border-slate-300 bg-slate-100 text-slate-600' %>">
                    <%= row.bom_is_active ? (t("active") ) : (t("inactive") ) %>
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-500">N/A</span>
                <% } %>
              </td>
              <td class="px-4 py-3 text-slate-700" data-sort-value="<%= row.created_at ? new Date(row.created_at).toISOString() : '' %>"><%= formatDateDisplay(row.created_at) %></td>
              <td class="px-4 py-3">
                <div class="flex justify-end gap-2">
                  <a href="<%= basePath %>/<%= row.id %>" class="inline-flex items-center justify-center rounded-md border border-slate-200 bg-white p-2 text-slate-600 transition hover:border-slate-300 hover:text-slate-900" title="<%= t('view')  %>" aria-label="<%= t('view')  %>">
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                      <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6" />
                    </svg>
                  </a>
                  <% if (row.status === "APPROVED" && can("SCREEN", "master_data.bom", "delete")) { %>
                    <form method="POST" action="<%= basePath %>/<%= row.id %>/toggle-lifecycle" class="inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button
                        type="submit"
                        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-slate-200 bg-white text-slate-600 transition hover:border-slate-300 hover:text-slate-900"
                        title="<%= row.bom_is_active ? (t('deactivate') ) : (t('activate') ) %>"
                        aria-label="<%= row.bom_is_active ? (t('deactivate') ) : (t('activate') ) %>"
                      >
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                          <% if (row.bom_is_active) { %>
                            <path d="M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                          <% } else { %>
                            <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                          <% } %>
                        </svg>
                      </button>
                    </form>
                  <% } else { %>
                    <button
                      type="button"
                      disabled
                      class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-slate-300"
                      title="<%= t('not_applicable')  %>"
                      aria-label="<%= t('not_applicable')  %>"
                    >
                      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                      </svg>
                    </button>
                  <% } %>
                  <% if (row.status === "APPROVED" && can("SCREEN", "master_data.bom", "create")) { %>
                    <form method="POST" action="<%= basePath %>/<%= row.id %>/create-new-version" class="inline">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="inline-flex min-w-34 items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600 transition hover:border-slate-300 hover:text-slate-800" title="<%= t('bom_create_new_version')  %>">
                        <%= t("bom_revise")  %>
                      </button>
                    </form>
                  <% } %>
                  <% if (row.status === "DRAFT") { %>
                    <form method="POST" action="<%= basePath %>/<%= row.id %>/delete-draft" class="inline" onsubmit="return window.confirm(<%- JSON.stringify(t('confirm_delete') ) %>)">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="inline-flex min-w-34 items-center justify-center rounded-lg border border-rose-200 bg-rose-50 px-3 py-1.5 text-xs font-semibold text-rose-700 transition hover:bg-rose-100">
                        <%= t("delete_draft")  %>
                      </button>
                    </form>
                  <% } %>
                  <% if (row.status === "PENDING" && user?.isAdmin) { %>
                    <a
                      href="/administration/approvals?status=PENDING&entity_type=BOM&entity_id=<%= row.id %>"
                      class="inline-flex min-w-34 items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 transition hover:border-slate-300 hover:text-slate-900"
                    >
                      <%= t("open_approval")  %>
                    </a>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include("../../base/partials/table-footer", {
      t,
      serverPaging: {
        page: paging.page,
        pageCount: paging.pageCount,
        from: paging.from,
        to: paging.to,
        total: paging.total,
        pageUrl: buildPageUrl,
      },
    }) %>
  </section>
</div>

<%- include("../../base/partials/filter-modal", {
  t,
  bodyPartial: "../../master_data/bom/filters.ejs",
  serverFilters: false,
  selectedWorkflow,
  selectedBomType,
}) %>

<script>
  (() => {
    const form = document.querySelector("[data-bom-filter-form]");
    if (!form) return;

    const selects = Array.from(form.querySelectorAll("select"));
    selects.forEach((selectEl) => {
      selectEl.addEventListener("change", () => form.requestSubmit());
    });

    const searchInput = form.querySelector("[data-search-input]");
    if (!(searchInput instanceof HTMLInputElement)) return;

    // Search runs server-side via a full-page reload. Without this, focus/caret
    // are lost after each submit and typing feels broken. Restore both so the
    // user can keep typing to refine the query.
    if (searchInput.value) {
      const caret = searchInput.value.length;
      window.requestAnimationFrame(() => {
        searchInput.focus({ preventScroll: true });
        try {
          searchInput.setSelectionRange(caret, caret);
        } catch (err) {
          /* setSelectionRange unsupported — focus alone is enough */
        }
      });
    }

    let submitTimer = null;
    searchInput.addEventListener("input", () => {
      window.clearTimeout(submitTimer);
      // Longer debounce than client-side pages: each submit is a full reload.
      submitTimer = window.setTimeout(() => form.requestSubmit(), 500);
    });
    searchInput.addEventListener("keydown", (event) => {
      if (event.key !== "Enter") return;
      event.preventDefault();
      window.clearTimeout(submitTimer);
      form.requestSubmit();
    });

    // Sorting is server-side too, so the header buttons rendered by
    // table-header.ejs (which are inert without basic-info-utils.ejs) have to
    // resubmit the filter form instead of reordering the current page only.
    const sortInput = form.querySelector("[data-bom-sort-input]");
    const dirInput = form.querySelector("[data-bom-dir-input]");
    const activeSortKey = sortInput?.value || "";
    const activeSortDir = dirInput?.value === "asc" ? "asc" : "desc";
    document.querySelectorAll("[data-sort-key]").forEach((button) => {
      const key = button.getAttribute("data-sort-key") || "";
      const indicator = button.querySelector("[data-sort-indicator]");
      if (key === activeSortKey && indicator) {
        indicator.textContent = activeSortDir === "asc" ? "↑" : "↓";
        indicator.classList.remove("opacity-60");
      }
      button.addEventListener("click", () => {
        if (!sortInput || !dirInput) return;
        // Same column toggles direction; a new column starts ascending.
        dirInput.value = key === activeSortKey && activeSortDir === "asc" ? "desc" : "asc";
        sortInput.value = key;
        form.requestSubmit();
      });
    });

    const filterToggle = form.querySelector("[data-filter-toggle]");
    const filterCount = form.querySelector("[data-filter-count]");
    const workflowInput = form.querySelector("[data-bom-workflow-input]");
    const bomTypeInput = form.querySelector("[data-bom-type-input]");
    const filterPanel = document.querySelector("[data-filter-panel]");
    const panelWorkflow = filterPanel?.querySelector("[data-bom-modal-workflow]");
    const panelType = filterPanel?.querySelector("[data-bom-modal-type]");
    const panelClose = filterPanel?.querySelector("[data-filter-close]");
    const panelApply = filterPanel?.querySelector("[data-filter-apply]");
    const panelClear = filterPanel?.querySelector("[data-filter-clear]");

    const normalizeValue = (value) => String(value || "").trim();
    const isAllValue = (value) => normalizeValue(value).toLowerCase() === "all";

    const updateFilterCount = () => {
      if (!(filterCount instanceof HTMLElement)) return;
      let active = 0;
      if (!isAllValue(workflowInput?.value)) active += 1;
      if (!isAllValue(bomTypeInput?.value)) active += 1;
      if (active > 0) {
        filterCount.textContent = String(active);
        filterCount.classList.remove("hidden");
      } else {
        filterCount.classList.add("hidden");
      }
    };

    const closePanel = () => {
      if (!filterPanel) return;
      filterPanel.classList.add("hidden");
      filterPanel.classList.remove("flex");
    };

    // searchable-select.js keeps the real <select> in the DOM but renders a text
    // input over it, and only refreshes that input on a "change" event. Setting
    // .value alone would leave the visible control showing the previous filter.
    const setPanelSelect = (select, value) => {
      if (!select) return;
      const next = value || "all";
      if (select.value === next) return;
      select.value = next;
      select.dispatchEvent(new Event("change", { bubbles: true }));
    };

    const openPanel = () => {
      if (!filterPanel || !panelWorkflow || !panelType) return;
      setPanelSelect(panelWorkflow, workflowInput?.value);
      setPanelSelect(panelType, bomTypeInput?.value);
      filterPanel.classList.remove("hidden");
      filterPanel.classList.add("flex");
    };

    filterToggle?.addEventListener("click", openPanel);
    panelClose?.addEventListener("click", closePanel);
    panelApply?.addEventListener("click", () => {
      if (workflowInput && panelWorkflow) workflowInput.value = panelWorkflow.value || "all";
      if (bomTypeInput && panelType) bomTypeInput.value = panelType.value || "all";
      updateFilterCount();
      closePanel();
      form.requestSubmit();
    });
    panelClear?.addEventListener("click", () => {
      setPanelSelect(panelWorkflow, "all");
      setPanelSelect(panelType, "all");
      if (workflowInput) workflowInput.value = "all";
      if (bomTypeInput) bomTypeInput.value = "all";
      updateFilterCount();
      closePanel();
      form.requestSubmit();
    });
    filterPanel?.addEventListener("click", (event) => {
      if (event.target !== filterPanel) return;
      closePanel();
    });

    updateFilterCount();
  })();
</script>
