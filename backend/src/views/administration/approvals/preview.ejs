<%
  const escapeAttr = (value) =>
    String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  const valuesAttr = escapeAttr(JSON.stringify(previewValues ?? {}));
  const safeFieldErrors = typeof fieldErrors !== "undefined" && fieldErrors ? fieldErrors : {};
  const safeFormValues = typeof formValues !== "undefined" && formValues ? formValues : {};
%>
<div
  class="space-y-4"
  data-approval-preview
  data-preview-type="<%= previewType || '' %>"
  data-preview-action="<%= previewAction || '' %>"
  data-preview-values="<%- valuesAttr %>"
>
  <div class="flex flex-col border-b border-slate-200 pb-3">
    <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-400"><%= previewLabel %></span>
    <span class="text-sm font-semibold text-slate-700"><%= previewTitle %></span>
  </div>
  <div class="space-y-5" data-preview-body>
    <%- include(formPartial, { fieldErrors: safeFieldErrors, formValues: safeFormValues, modalValues: (previewValues ?? {}) }) %>
    <%# The generic preview already renders the whole payload; adding the %>
    <%# client-side raw-value fallback under it would just duplicate it. %>
    <%# sku-bulk-create is in the same boat: it renders a complete table and has %>
    <%# no [data-field] inputs, so the fallback would read it as an empty preview %>
    <%# and dump the whole planned-variant payload as raw JSON under the table. %>
    <% if (previewType !== 'voucher' && previewType !== 'generic' && previewType !== 'sku-bulk-create') { %><div class="hidden space-y-3" data-preview-fallback></div><% } %>
  </div>
</div>
