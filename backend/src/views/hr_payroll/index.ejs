<script>
  (function () {
    const form = document.querySelector("[data-modal-form]");
    if (!form) return;

    const getControllerValue = (name) => {
      const input = form.querySelector(`[data-field="${name}"]`);
      if (!input) return "";
      if (input.type === "checkbox") return input.checked ? "true" : "false";
      return (input.value || "").toString();
    };

    let _isRefreshing = false;
    let _refreshScheduled = false;

    const refreshConditionalFields = () => {
      if (_isRefreshing) return;
      _isRefreshing = true;
      _refreshScheduled = false;
      try {
        const newlyVisible = [];
        const nodes = form.querySelectorAll("[data-show-when-field], [data-show-when-not-field]");
        nodes.forEach((node) => {
          const wasHidden = node.classList.contains("hidden");
          let shouldShow = true;
          const whenField = node.getAttribute("data-show-when-field");
          const whenValues = (node.getAttribute("data-show-when-values") || "")
            .split(",")
            .map((v) => v.trim())
            .filter(Boolean);
          if (whenField && whenValues.length) {
            const current = getControllerValue(whenField);
            shouldShow = whenValues.includes(current);
          }

          const whenNotField = node.getAttribute("data-show-when-not-field");
          const whenNotValues = (node.getAttribute("data-show-when-not-values") || "")
            .split(",")
            .map((v) => v.trim())
            .filter(Boolean);
          if (whenNotField && whenNotValues.length) {
            const current = getControllerValue(whenNotField);
            if (whenNotValues.includes(current)) shouldShow = false;
          }

          const controls = node.querySelectorAll("[data-field]");
          if (shouldShow) {
            node.classList.remove("hidden");
            if (wasHidden) newlyVisible.push(node);
            controls.forEach((ctrl) => {
              ctrl.disabled = false;
              if (ctrl.hasAttribute("data-required")) ctrl.setAttribute("required", "required");
            });
          } else {
            node.classList.add("hidden");
            controls.forEach((ctrl) => {
              ctrl.disabled = true;
              ctrl.removeAttribute("required");
              if (ctrl.type === "checkbox") {
                if (ctrl.checked) {
                  ctrl.checked = false;
                  ctrl.dispatchEvent(new Event("change", { bubbles: true }));
                }
              } else if (ctrl.tagName === "SELECT") {
                if (String(ctrl.value || "") !== "") {
                  ctrl.value = "";
                  ctrl.dispatchEvent(new Event("change", { bubbles: true }));
                }
              } else if (String(ctrl.value || "") !== "") {
                ctrl.value = "";
              }
            });
          }
        });

        if (newlyVisible.length && typeof window.initSearchableSelects === "function") {
          newlyVisible.forEach((container) => window.initSearchableSelects(container));
        }
      } finally {
        _isRefreshing = false;
      }
    };

    const scheduleRefreshConditionalFields = () => {
      if (_refreshScheduled) return;
      _refreshScheduled = true;
      setTimeout(refreshConditionalFields, 0);
    };

    form.addEventListener("change", (e) => {
      if (e.target && e.target.matches("[data-field]")) scheduleRefreshConditionalFields();
    });
    document.addEventListener("modal:opened", refreshConditionalFields);
    setTimeout(refreshConditionalFields, 0);
  })();
</script>
<script>
  (function () {
    const rateViewSelect = document.querySelector('[name="rate_view"]');
    if (!rateViewSelect) return;

    const PAIRS_PER_DOZEN = 12;
    const scopeKey = "<%= page.scopeKey %>";
    const tPerDozen = "<%= t('rate_type_per_dozen')  %>";
    const tPerPair = "<%= t('rate_type_per_pair')  %>";
    const tRate = "<%= t('rate') %>";

    const toNumber = (value) => {
      const parsed = Number(value);
      return Number.isFinite(parsed) ? parsed : null;
    };

    const normalizeRateType = (rawValue, fallback = "PER_PAIR") => {
      const raw = String(rawValue || "").trim().toUpperCase().replace(/[\s-]+/g, "_");
      if (!raw) return fallback;
      if (raw === "PAIR" || raw === "PERPAIR") return "PER_PAIR";
      if (raw === "DOZEN" || raw === "PERDOZEN") return "PER_DOZEN";
      if (raw === "PER_PAIR" || raw === "PER_DOZEN") return raw;
      return fallback;
    };

    const convertRate = (value, sourceType, targetType) => {
      if (!Number.isFinite(value)) return null;
      const src = normalizeRateType(sourceType, "PER_PAIR");
      const target = normalizeRateType(targetType, "PER_DOZEN");
      if (src === target) return value;
      if (src === "PER_PAIR" && target === "PER_DOZEN") return value * PAIRS_PER_DOZEN;
      if (src === "PER_DOZEN" && target === "PER_PAIR") return value / PAIRS_PER_DOZEN;
      return value;
    };

    const applyRateView = () => {
      const targetType = normalizeRateType(rateViewSelect.value, "PER_DOZEN");
      if (scopeKey === "hr_payroll.labour_rates") {
        const rateHeaderLabel = document.querySelector(
          'button[data-sort-key="rate_value"] > span:first-child',
        );
        if (rateHeaderLabel) {
          rateHeaderLabel.textContent =
            targetType === "PER_PAIR"
              ? `${tPerPair} ${tRate}`
              : `${tPerDozen} ${tRate}`;
        }
      }
      const rows = document.querySelectorAll("tr[data-row]");
      rows.forEach((row) => {
        const rateValueCell = row.querySelector("[data-rate-value-cell]");
        const rateTypeCell = row.querySelector("[data-rate-type-cell]");

        const rawValue = toNumber(row.getAttribute("data-rate-amount"));
        const sourceType = normalizeRateType(row.getAttribute("data-rate-type"), "PER_PAIR");
        const commissionBasis = String(row.getAttribute("data-commission-basis") || "").trim().toUpperCase();
        const allowConversion = !(scopeKey === "hr_payroll.commissions" && commissionBasis && commissionBasis !== "FIXED_PER_UNIT");
        const displayedRateType = allowConversion ? targetType : sourceType;

        if (rateTypeCell) {
          rateTypeCell.textContent = displayedRateType === "PER_DOZEN" ? tPerDozen : tPerPair;
        }

        if (!rateValueCell || !Number.isFinite(rawValue)) return;
        const converted = allowConversion ? convertRate(rawValue, sourceType, targetType) : rawValue;
        if (!Number.isFinite(converted)) return;
        rateValueCell.textContent = converted.toFixed(2);
      });
    };

    rateViewSelect.addEventListener("change", applyRateView);
    applyRateView();
  })();
</script>
