<script>
  (function () {
    const form = document.querySelector("[data-modal-form]");
    const modal = document.querySelector("[data-modal]");
    const modalError = document.querySelector("[data-modal-error]");
    const modalNotice = document.querySelector("[data-modal-notice]");
    const panel = document.querySelector("[data-commission-bulk-panel]");
    const summary = document.querySelector("[data-commission-bulk-summary]");
    const tbody = document.querySelector("[data-commission-bulk-body]");
    if (!form || !modal || !panel || !summary || !tbody) return;

    const basePath = "<%= basePath %>";
    const csrfToken = "<%= csrfToken %>";
    const tNoEntries = "<%= t('no_entries') %>";
    const tSelectTarget = "<%= t('select_target_to_preview_impact') %>";
    const tAffected = "<%= t('affected_skus') %>";
    const tNoPrevious = "<%= t('none') %>";
    const tInvalidApplyOn = "<%= t('error_group_subgroup_only_for_bulk_commission') %>";
    const tSaved = "<%= t('success_bulk_commission_saved') %>";
    const tLoading = "<%= t('loading') %>";
    const tLoadFailed = "<%= t('load_failed') %>";
    const tNetworkError = "<%= t('network_error') %>";
    const tUnableSave = "<%= t('error_unable_save') %>";
    const tRequiredFields = "<%= t('error_required_fields') %>";
    const tSelectCommissionBasis = "<%= t('error_select_commission_basis') %>";
    const tEffectiveFromRequired = "<%= t('error_effective_from_required') %>";
    const tInvalidDateRange = "<%= t('error_invalid_date_range') %>";
    const tSelectRateType = "<%= t('error_select_rate_type') %>";
    const tViewPendingApproval = "<%= t('view_pending_approval') %>";
    const tSaveSummaryTemplate = "<%= t('success_bulk_commission_saved_counts') %>";

    const fields = {
      employeeId: form.querySelector('[data-field="employee_id"]'),
      commissionType: form.querySelector('[data-field="commission_type"]'),
      applyOn: form.querySelector('[data-field="apply_on"]'),
      subgroupId: form.querySelector('[data-field="subgroup_id"]'),
      groupId: form.querySelector('[data-field="group_id"]'),
      commissionBasis: form.querySelector('[data-field="commission_basis"]'),
      rateType: form.querySelector('[data-field="rate_type"]'),
      value: form.querySelector('[data-field="value"]'),
      reverseOnReturns: form.querySelector('[data-field="reverse_on_returns"]'),
      status: form.querySelector('[data-field="status"]'),
      branchId: form.querySelector('[data-field="branch_id"]'),
      effectiveFrom: form.querySelector('[data-field="effective_from"]'),
      effectiveTo: form.querySelector('[data-field="effective_to"]'),
    };

    const state = {
      rows: [],
      requestSeq: 0,
      debounceTimer: null,
      loading: false,
      windowStart: -1,
      windowEnd: -1,
      rowHeight: 0,
      scrollFrame: null,
    };

    const getErrorMessage = (payload, fallback) => {
      if (!payload || typeof payload !== "object") return fallback;
      const message = payload.message || payload.error || payload.detail;
      if (typeof message === "string" && message.trim()) return message.trim();
      return fallback;
    };

    const hideModalNotice = () => {
      if (!modalNotice) return;
      modalNotice.textContent = "";
      modalNotice.hidden = true;
    };

    const showModalError = (message) => {
      hideModalNotice();
      if (!modalError) return;
      modalError.textContent = message;
      modalError.hidden = false;
    };

    const hideModalError = () => {
      if (!modalError) return;
      modalError.textContent = "";
      modalError.hidden = true;
    };

    const showModalNotice = ({ message, linkHref = "", linkLabel = "" }) => {
      if (!modalNotice) return;
      hideModalError();
      modalNotice.textContent = "";
      const textNode = document.createTextNode(message || "");
      modalNotice.appendChild(textNode);
      if (linkHref && linkLabel) {
        const spacer = document.createTextNode(" ");
        modalNotice.appendChild(spacer);
        const anchor = document.createElement("a");
        anchor.href = linkHref;
        anchor.className = "font-semibold underline";
        anchor.textContent = linkLabel;
        modalNotice.appendChild(anchor);
      }
      modalNotice.hidden = false;
    };

    const formatSaveSummary = (created, updated) =>
      tSaveSummaryTemplate
        .replace("{created}", String(created))
        .replace("{updated}", String(updated));

    const clearSelectField = (field) => {
      if (!(field instanceof HTMLSelectElement)) return;
      if (field.multiple) {
        Array.from(field.options || []).forEach((option) => {
          option.selected = false;
        });
      } else {
        field.value = "";
      }
      field.dispatchEvent(new Event("change", { bubbles: true }));
    };

    const getSelectedValues = (field) => {
      if (!(field instanceof HTMLSelectElement)) return [];
      if (field.multiple) {
        return Array.from(field.selectedOptions || [])
          .map((option) => String(option.value || "").trim())
          .filter(Boolean);
      }
      const value = String(field.value || "").trim();
      return value ? [value] : [];
    };

    const resetSelections = () => {
      if (fields.employeeId) {
        clearSelectField(fields.employeeId);
      }
      if (fields.applyOn) {
        clearSelectField(fields.applyOn);
      }
      if (fields.subgroupId) {
        clearSelectField(fields.subgroupId);
      }
      if (fields.groupId) {
        clearSelectField(fields.groupId);
      }
      if (fields.commissionBasis) {
        clearSelectField(fields.commissionBasis);
      }
      if (fields.rateType) {
        fields.rateType.value = "PER_PAIR";
        fields.rateType.dispatchEvent(new Event("change", { bubbles: true }));
      }
      if (fields.value) fields.value.value = "";
      if (fields.reverseOnReturns) fields.reverseOnReturns.checked = true;
      if (fields.status) {
        fields.status.value = "active";
        fields.status.dispatchEvent(new Event("change", { bubbles: true }));
      }
      hideModalError();
      hideModalNotice();
      clearRows(tSelectTarget);
      setPanelVisibility();
    };

    const normalizeApplyOn = () => String(fields.applyOn?.value || "").trim().toUpperCase();
    const isBulkMode = () => {
      const applyOn = normalizeApplyOn();
      return applyOn === "SUBGROUP" || applyOn === "GROUP";
    };

    const setPanelVisibility = () => {
      if (modal.dataset.mode !== "create" || !isBulkMode()) {
        panel.classList.add("hidden");
        return;
      }
      panel.classList.remove("hidden");
    };

    const renderEmpty = (message) => {
      tbody.innerHTML = `<tr><td class="px-2 py-2 text-slate-500" colspan="4">${message || tNoEntries}</td></tr>`;
    };

    // Same windowing as the labour-rate grid below: the scroller is max-h-72
    // (~12 rows), but a group scope resolves to the whole catalogue. Painting
    // every row cost ~0.7s per preview and made typing the header rate lag,
    // because each row carries a number input. state.rows stays complete —
    // Save posts from it, so windowing the DOM must never window the data.
    const ROW_OVERSCAN = 8;
    const FALLBACK_ROW_HEIGHT = 30;
    const scroller = tbody.closest(".overflow-auto") || tbody.parentElement;

    const rowHtml = (row, idx) => {
      const previous = row.previous_rate == null ? tNoPrevious : Number(row.previous_rate).toFixed(2);
      const newRate = row.new_rate == null ? "" : Number(row.new_rate).toFixed(2);
      // whitespace-nowrap keeps every row the same height, which is what makes
      // the spacer arithmetic exact. The scroller already scrolls sideways.
      return `
        <tr data-commission-row="${idx}">
          <td class="px-2 py-1.5 text-slate-700 whitespace-nowrap">${row.sku_code || ""}</td>
          <td class="px-2 py-1.5 text-slate-700 whitespace-nowrap">${row.item_name || ""}</td>
          <td class="px-2 py-1.5 text-slate-700 whitespace-nowrap">${previous}</td>
          <td class="px-2 py-1.5 text-slate-700">
            <input
              class="w-28 rounded-md border border-slate-200 bg-white px-2 py-1 text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-accent/30"
              type="number"
              min="0"
              step="0.01"
              data-commission-row-rate
              data-commission-row-index="${idx}"
              value="${newRate}"
            />
          </td>
        </tr>
      `;
    };

    const spacerHtml = (height) =>
      height > 0 ? `<tr aria-hidden="true"><td colspan="4" style="height:${height}px;padding:0;border:0"></td></tr>` : "";

    const measureRowHeight = () => {
      const sample = tbody.querySelector("[data-commission-row]");
      if (!sample) return;
      const height = sample.getBoundingClientRect().height;
      if (height > 0) state.rowHeight = height;
    };

    const visibleRange = () => {
      const total = state.rows.length;
      const rowHeight = state.rowHeight || FALLBACK_ROW_HEIGHT;
      const viewport = scroller ? scroller.clientHeight || 0 : 0;
      // clientHeight is 0 while the modal is still hidden. Render a small block
      // rather than the whole list — the spacers keep the scrollbar honest and
      // the first scroll repaints against a real viewport.
      if (!viewport) return { start: 0, end: Math.min(total, 40) };
      const scrollTop = scroller.scrollTop || 0;
      const start = Math.max(0, Math.floor(scrollTop / rowHeight) - ROW_OVERSCAN);
      const end = Math.min(total, Math.ceil((scrollTop + viewport) / rowHeight) + ROW_OVERSCAN);
      return { start, end: Math.max(end, start) };
    };

    const paintWindow = ({ force = false } = {}) => {
      const total = state.rows.length;
      if (!total) return;
      const { start, end } = visibleRange();
      if (!force && start === state.windowStart && end === state.windowEnd) return;

      // Re-rendering blows away the focused input, so put the caret back if the
      // row the user was typing in is still on screen.
      const active = document.activeElement;
      const focusedIndex =
        active instanceof HTMLInputElement && active.hasAttribute("data-commission-row-rate")
          ? Number(active.getAttribute("data-commission-row-index"))
          : null;
      const selectionStart = focusedIndex == null ? null : active.selectionStart;
      const selectionEnd = focusedIndex == null ? null : active.selectionEnd;

      const rowHeight = state.rowHeight || FALLBACK_ROW_HEIGHT;
      let html = spacerHtml(start * rowHeight);
      for (let idx = start; idx < end; idx += 1) {
        html += rowHtml(state.rows[idx], idx);
      }
      html += spacerHtml((total - end) * rowHeight);
      tbody.innerHTML = html;
      state.windowStart = start;
      state.windowEnd = end;

      if (focusedIndex != null && focusedIndex >= start && focusedIndex < end) {
        const restored = tbody.querySelector(`[data-commission-row-index="${focusedIndex}"]`);
        if (restored instanceof HTMLInputElement) {
          restored.focus();
          if (selectionStart != null && selectionEnd != null) {
            try {
              restored.setSelectionRange(selectionStart, selectionEnd);
            } catch (err) {
              /* number inputs reject setSelectionRange in some browsers */
            }
          }
        }
      }
    };

    const renderRows = () => {
      summary.textContent = String(state.rows.length);
      state.windowStart = -1;
      state.windowEnd = -1;
      if (!state.rows.length) {
        renderEmpty(tNoEntries);
        summary.textContent = "0";
        return;
      }
      if (scroller) scroller.scrollTop = 0;
      // First paint with the previous (or fallback) height, measure, then repaint
      // so the spacers are exact from the very first frame.
      paintWindow({ force: true });
      const before = state.rowHeight;
      measureRowHeight();
      if (state.rowHeight !== before) paintWindow({ force: true });
    };

    if (scroller) {
      scroller.addEventListener(
        "scroll",
        () => {
          if (!state.rows.length) return;
          if (state.scrollFrame) return;
          state.scrollFrame = window.requestAnimationFrame(() => {
            state.scrollFrame = null;
            paintWindow();
          });
        },
        { passive: true },
      );
    }

    // state.rows is what Save posts, so every row tracks the header rate. Only
    // the windowed inputs are in the DOM, so the repaint is a handful of writes.
    const applyHeaderRateToRows = () => {
      const headerRate = String(fields.value?.value || "").trim();
      if (!state.rows.length) return;
      state.rows.forEach((row) => {
        row.new_rate = headerRate;
      });
      const inputs = tbody.querySelectorAll("[data-commission-row-rate]");
      inputs.forEach((input) => {
        input.value = headerRate;
      });
    };

    const clearRows = (message = tSelectTarget) => {
      state.rows = [];
      state.windowStart = -1;
      state.windowEnd = -1;
      renderEmpty(message);
      summary.textContent = "0";
    };

    const getPreviewQuery = () => {
      const applyOn = normalizeApplyOn();
      const employeeId = String(fields.employeeId?.value || "").trim();
      const commissionBasis = String(fields.commissionBasis?.value || "FIXED_PER_UNIT").trim();
      const subgroupIds = getSelectedValues(fields.subgroupId);
      const groupIds = getSelectedValues(fields.groupId);
      const rateType = String(fields.rateType?.value || "").trim();

      if (!applyOn) return null;
      if (applyOn === "SUBGROUP" && !subgroupIds.length) return null;
      if (applyOn === "GROUP" && !groupIds.length) return null;

      const params = new URLSearchParams({
        apply_on: applyOn,
      });
      if (employeeId) params.set("employee_id", employeeId);
      if (commissionBasis) params.set("commission_basis", commissionBasis);
      // Both scope the "previous rate" column: it must show the rate in force at
      // this branch on the day the new one starts, not just any existing row.
      const previewBranchId = String(fields.branchId?.value || "").trim();
      if (previewBranchId) params.set("branch_id", previewBranchId);
      const previewEffectiveFrom = String(fields.effectiveFrom?.value || "").trim();
      if (previewEffectiveFrom) params.set("effective_from", previewEffectiveFrom);
      if (subgroupIds.length) {
        params.set("subgroup_ids", subgroupIds.join(","));
        params.set("subgroup_id", subgroupIds[0]);
      }
      if (groupIds.length) {
        params.set("group_ids", groupIds.join(","));
        params.set("group_id", groupIds[0]);
      }
      if (rateType) params.set("rate_type", rateType);
      return params;
    };

    const loadPreview = async () => {
      setPanelVisibility();
      if (!isBulkMode()) {
        clearRows(tSelectTarget);
        return;
      }
      hideModalError();
      hideModalNotice();

      const commissionBasis = String(fields.commissionBasis?.value || "FIXED_PER_UNIT").trim();
      const rateType = String(fields.rateType?.value || "").trim();
      if (!rateType) {
        clearRows(tSelectRateType);
        return;
      }

      const params = getPreviewQuery();
      if (!params) {
        clearRows(tSelectTarget);
        return;
      }

const currentSeq = ++state.requestSeq;
      state.loading = true;
      
      // FORCE the table to clear old rows and show the spinner immediately
      clearRows(tLoading, true);

      try {        const response = await fetch(`${basePath}/bulk-preview?${params.toString()}`, {
          method: "GET",
          headers: { Accept: "application/json" },
          credentials: "same-origin",
        });
        const payload = await response.json().catch(() => ({}));
        if (currentSeq !== state.requestSeq) return;
        state.loading = false;
        if (response.status === 401) {
          window.location.href = "/auth/login";
          return;
        }
        if (!response.ok) {
          clearRows(getErrorMessage(payload, tLoadFailed));
          return;
        }
        state.rows = Array.isArray(payload.rows) ? payload.rows : [];
        applyHeaderRateToRows();
        renderRows();
      } catch (err) {
        state.loading = false;
        clearRows(tNetworkError);
      }
    };

    const schedulePreview = () => {
      if (state.debounceTimer) window.clearTimeout(state.debounceTimer);
      state.debounceTimer = window.setTimeout(loadPreview, 400);
    };

    const normalizeCommaList = (raw) =>
      String(raw || "")
        .split(",")
        .map((token) => token.trim())
        .filter(Boolean);

    const getFirstMultiSelectValue = (selectEl) => {
      if (!(selectEl instanceof HTMLSelectElement)) return "";
      const selected = Array.from(selectEl.selectedOptions || [])
        .map((option) => String(option.value || "").trim())
        .filter(Boolean);
      if (selected.length) return selected[0];
      const direct = String(selectEl.value || "").trim();
      return direct;
    };

    const restoreMultiSelectFromSearchableText = (selectEl) => {
      if (!(selectEl instanceof HTMLSelectElement) || !selectEl.multiple) return;
      const selectedCount = Array.from(selectEl.selectedOptions || []).length;
      if (selectedCount > 0) return;
      const searchableInput = selectEl.closest("[data-searchable-wrapper]")?.querySelector('input[type="text"]');
      if (!(searchableInput instanceof HTMLInputElement)) return;
      const tokens = normalizeCommaList(searchableInput.value);
      if (!tokens.length) return;
      const lowerTokens = tokens.map((token) => token.toLowerCase());
      let matched = 0;
      Array.from(selectEl.options || []).forEach((option) => {
        const label = String(option.textContent || "").trim().toLowerCase();
        const isMatch = lowerTokens.some((token) => token && label === token);
        option.selected = isMatch;
        if (isMatch) matched += 1;
      });
      if (matched > 0) {
        selectEl.dispatchEvent(new Event("input", { bubbles: true }));
        selectEl.dispatchEvent(new Event("change", { bubbles: true }));
      }
    };

    form.addEventListener("input", (event) => {
      const target = event.target;
      if (!target) return;
      if (target.hasAttribute("data-commission-row-rate")) {
        const index = Number(target.getAttribute("data-commission-row-index"));
        if (!Number.isInteger(index) || !state.rows[index]) return;
        state.rows[index].new_rate = target.value;
        return;
      }
      if (target.matches("[data-field='value']")) {
        applyHeaderRateToRows();
      }
    });

    form.addEventListener(
      "wheel",
      (event) => {
        const target = event.target;
        if (!(target instanceof HTMLInputElement)) return;
        if (target.type !== "number") return;
        if (document.activeElement !== target) return;
        event.preventDefault();
      },
      { passive: false },
    );

    form.addEventListener("change", (event) => {
      const target = event.target;
      if (!target) return;
      if (target.matches("[data-field='employee_id'], [data-field='apply_on'], [data-field='subgroup_id'], [data-field='group_id'], [data-field='commission_basis'], [data-field='rate_type'], [data-field='branch_id'], [data-field='effective_from']")) {
        schedulePreview();
      }
    });

    document.addEventListener("modal:opened", () => {
      state.requestSeq += 1;
      if (fields.value instanceof HTMLInputElement) {
        // Keep decimal commission rates valid even if browser/default step gets reset.
        fields.value.setAttribute("step", "0.01");
        fields.value.setAttribute("min", "0");
      }
      setPanelVisibility();
      schedulePreview();
    });

    const modalObserver = new MutationObserver(() => {
      if (modal.classList.contains("hidden")) {
        resetSelections();
      }
    });
    modalObserver.observe(modal, { attributes: true, attributeFilter: ["class"] });

    form.addEventListener(
      "submit",
      async (event) => {
        if (modal.dataset.mode !== "create") return;
        if (!isBulkMode()) {
          restoreMultiSelectFromSearchableText(fields.employeeId);
          restoreMultiSelectFromSearchableText(form.querySelector('[data-field="sku_id"]'));
          return;
        }
        event.preventDefault();
        event.stopImmediatePropagation();
        hideModalError();
        hideModalNotice();

        const commissionBasis = String(fields.commissionBasis?.value || "FIXED_PER_UNIT").trim();
        const rateType = String(fields.rateType?.value || "").trim();
        if (!commissionBasis) {
          showModalError(tSelectCommissionBasis);
          return;
        }
        if (!rateType) {
          showModalError(tSelectRateType);
          return;
        }

        if (!state.rows.length) {
          showModalError(tSelectTarget);
          return;
        }

        const payload = {
          _csrf: csrfToken,
          employee_id: getFirstMultiSelectValue(fields.employeeId),
          commission_type: String(fields.commissionType?.value || "SALESMAN_SALE").trim().toUpperCase(),
          apply_on: normalizeApplyOn(),
          subgroup_ids: getSelectedValues(fields.subgroupId),
          group_ids: getSelectedValues(fields.groupId),
          scope_rate: String(fields.value?.value || state.rows[0]?.new_rate || "").trim(),
          commission_basis: commissionBasis,
          rate_type: rateType,
          reverse_on_returns: Boolean(fields.reverseOnReturns?.checked),
          status: fields.status?.value || "active",
          branch_id: String(fields.branchId?.value || "").trim() || null,
          effective_from: String(fields.effectiveFrom?.value || "").trim(),
          effective_to: String(fields.effectiveTo?.value || "").trim() || null,
          rows: state.rows.map((row) => ({
            sku_id: row.sku_id,
            new_rate: row.new_rate,
          })),
        };
        payload.subgroup_id = payload.subgroup_ids[0] || null;
        payload.group_id = payload.group_ids[0] || null;

        if (!payload.employee_id) {
          showModalError(tRequiredFields);
          return;
        }
        if (payload.apply_on !== "SUBGROUP" && payload.apply_on !== "GROUP") {
          showModalError(tInvalidApplyOn);
          return;
        }
        if (!payload.scope_rate) {
          showModalError(tRequiredFields);
          return;
        }
        if (!payload.effective_from) {
          showModalError(tEffectiveFromRequired);
          return;
        }
        if (payload.effective_to && payload.effective_to < payload.effective_from) {
          showModalError(tInvalidDateRange);
          return;
        }

        try {
          const response = await fetch(`${basePath}/bulk-upsert`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "x-csrf-token": csrfToken,
              Accept: "application/json",
            },
            credentials: "same-origin",
            body: JSON.stringify(payload),
          });

          const result = await response.json().catch(() => ({}));
          if (response.status === 401) {
            window.location.href = "/auth/login";
            return;
          }
          if (!response.ok) {
            showModalError(getErrorMessage(result, tUnableSave));
            return;
          }

          if (result.queued) {
            showModalNotice({
              message: result.message || tSaved,
              linkHref: result.approvals_url || "",
              linkLabel: result.approvals_url ? tViewPendingApproval : "",
            });
            return;
          }

          const createdCount = Number(result.created || 0);
          const updatedCount = Number(result.updated || 0);
          showModalNotice({
            message: `${result.message || tSaved} ${formatSaveSummary(createdCount, updatedCount)}`,
          });
          window.setTimeout(() => {
            window.location.href = basePath;
          }, 1200);
        } catch (err) {
          showModalError(tNetworkError);
        }
      },
      true,
    );

    setPanelVisibility();
    if (fields.value instanceof HTMLInputElement) {
      fields.value.setAttribute("step", "0.01");
      fields.value.setAttribute("min", "0");
    }
    clearRows(tSelectTarget);
  })();
</script>
<% } %>

<% if (page.scopeKey === "hr_payroll.labour_rates") { %>
<script>
  (function () {
    const form = document.querySelector("[data-modal-form]");
    const modal = document.querySelector("[data-modal]");
    const modalError = document.querySelector("[data-modal-error]");
    const modalNotice = document.querySelector("[data-modal-notice]");
    const labourScopePanel = document.querySelector("[data-labour-rate-labour-scope-panel]");
    const labourScopeSummary = document.querySelector("[data-labour-rate-labour-scope-summary]");
    const labourScopeList = document.querySelector("[data-labour-rate-labour-scope-list]");
    const labourScopeBody = document.querySelector("[data-labour-rate-scope-body]");
    const labourScopeToggle = document.querySelector("[data-labour-rate-scope-toggle]");
    const panel = document.querySelector("[data-labour-rate-bulk-panel]");
    const summary = document.querySelector("[data-labour-rate-bulk-summary]");
    const tbody = document.querySelector("[data-labour-rate-bulk-body]");
    const skuBody = document.querySelector("[data-labour-rate-skus-body]");
    const skuToggle = document.querySelector("[data-labour-rate-skus-toggle]");
    const hasLabourScopePanel = Boolean(labourScopePanel && labourScopeSummary && labourScopeList);
    const hasLabourScopeAccordion = Boolean(labourScopeBody && labourScopeToggle);
    const hasSkuAccordion = Boolean(skuBody && skuToggle);
    if (!form || !modal || !panel || !summary || !tbody) return;

    const basePath = "<%= basePath %>";
    const csrfToken = "<%= csrfToken %>";
    const tNoEntries = "<%= t('no_entries') %>";
    const tSelectTarget = "<%= t('select_target_to_preview_impact') %>";
    const tAffected = "<%= t('affected_skus') %>";
    const tNoPrevious = "<%= t('none') %>";
    const tPerDozen = "<%= t('rate_type_per_dozen') %>";
    const tPerPair = "<%= t('rate_type_per_pair') %>";
    const tSaved = "<%= t('success_bulk_labour_rate_saved') %>";
    const tLoading = "<%= t('loading') %>";
    const tLoadFailed = "<%= t('load_failed') %>";
    const tNetworkError = "<%= t('network_error') %>";
    const tUnableSave = "<%= t('error_unable_save') %>";
    const tRequiredFields = "<%= t('error_required_fields') %>";
    const tSelectLabour = "<%= t('error_select_labour') %>";
    const tSelectDepartment = "<%= t('error_select_department') %>";
    const tSelectSku = "<%= t('error_select_sku') %>";
    const tSelectSubgroup = "<%= t('error_select_subgroup') %>";
    const tSelectGroup = "<%= t('error_select_group') %>";
    const tSelectArticleType = "<%= t('error_select_article_type') %>";
    const tSelectRateType = "<%= t('error_select_rate_type') %>";
    const tNoTargetSkus = "<%= t('error_no_target_skus_found') %>";
    const tViewPendingApproval = "<%= t('view_pending_approval') %>";
    const tSaveSummaryTemplate = "<%= t('success_bulk_labour_rate_saved_counts') %>";
    const tAppliesToLabours = "<%= t('applies_to_labours') %>";
    const tNoLaboursInDepartment = "<%= t('no_labours_found_for_department') %>";
    const tSelect = "<%= t('select') %>";
    const tExpand = "<%= t('expand') %>";
    const tCollapse = "<%= t('collapse') %>";
    const departmentOptionsPath = `${basePath}/department-options`;
    const resolvedLaboursPath = `${basePath}/resolved-labours`;
    const skuOptionsPath = `${basePath}/sku-options`;

    const fields = {
      labourId: form.querySelector('[data-field="labour_id"]'),
      deptId: form.querySelector('[data-field="dept_id"]'),
      applyOn: form.querySelector('[data-field="apply_on"]'),
      skuId: form.querySelector('[data-field="sku_id"]'),
      subgroupId: form.querySelector('[data-field="subgroup_id"]'),
      groupId: form.querySelector('[data-field="group_id"]'),
      articleType: form.querySelector('[data-field="article_type"]'),
      rateType: form.querySelector('[data-field="rate_type"]'),
      rateValue: form.querySelector('[data-field="rate_value"]'),
    };
    const fieldsByName = {
      labour_id: fields.labourId,
      dept_id: fields.deptId,
      apply_on: fields.applyOn,
      sku_id: fields.skuId,
      subgroup_id: fields.subgroupId,
      group_id: fields.groupId,
      article_type: fields.articleType,
      rate_type: fields.rateType,
      rate_value: fields.rateValue,
    };

    const state = {
      rows: [],
      requestSeq: 0,
      deptOptionsSeq: 0,
      skuOptionsSeq: 0,
      debounceTimer: null,
      headerRateRepaintTimer: null,
      loading: false,
      lockedEditValues: {},
      editSkuLabel: "",
      editSkuValue: "",
      windowStart: -1,
      windowEnd: -1,
      rowHeight: 0,
      scrollFrame: null,
    };
    const editLockedFields = new Set(["labour_id", "dept_id", "apply_on", "sku_id", "subgroup_id", "group_id", "article_type"]);
    const editVisibleFields = new Set(["sku_id", "rate_type", "rate_value"]);
    let skuReadonlyText = null;
    const hideLabourScope = () => {
      if (!hasLabourScopePanel) return;
      labourScopePanel.classList.add("hidden");
      labourScopeSummary.textContent = tSelectTarget;
      labourScopeList.innerHTML = "";
    };

    const setCollapsedState = (toggleEl, bodyEl, collapsed) => {
      toggleEl.dataset.collapsed = collapsed ? "true" : "false";
      toggleEl.textContent = collapsed ? tExpand : tCollapse;
      bodyEl.classList.toggle("hidden", collapsed);
    };

    const normalizeApplyOn = () => String(fields.applyOn?.value || "").trim().toUpperCase();
    const clearSelectField = (field) => {
      if (!(field instanceof HTMLSelectElement)) return;
      if (field.multiple) {
        Array.from(field.options || []).forEach((option) => {
          option.selected = false;
        });
      } else {
        field.value = "";
      }
      field.dispatchEvent(new Event("change", { bubbles: true }));
    };
    const getSelectedValues = (field) => {
      if (!(field instanceof HTMLSelectElement)) return [];
      if (field.multiple) {
        return Array.from(field.selectedOptions || [])
          .map((option) => String(option.value || "").trim())
          .filter((value) => value);
      }
      const value = String(field.value || "").trim();
      return value ? [value] : [];
    };
    const getSelectedLabourIds = () => {
      if (!fields.labourId) return [];
      if (fields.labourId instanceof HTMLSelectElement) {
        return getSelectedValues(fields.labourId);
      }
      const hiddenValues = String(fields.labourId.value || "")
        .split(",")
        .map((value) => value.trim())
        .filter((value) => value);
      if (hiddenValues.length) return hiddenValues;
      return Array.from(fields.labourId.selectedOptions || [])
        .map((option) => String(option.value || "").trim())
        .filter((value) => value);
    };
    const getSelectedSkuIds = () => {
      return getSelectedValues(fields.skuId);
    };
    const getSelectedSubgroupIds = () => getSelectedValues(fields.subgroupId);
    const getSelectedGroupIds = () => getSelectedValues(fields.groupId);
    const isBulkApplyOn = () => {
      const applyOn = normalizeApplyOn();
      return (
        applyOn === "ARTICLE" || applyOn === "SUBGROUP" || applyOn === "GROUP"
      );
    };

    const renderLabourScope = (rows) => {
      if (!hasLabourScopePanel) return;
      const safeRows = Array.isArray(rows) ? rows : [];
      if (!safeRows.length) {
        labourScopePanel.classList.remove("hidden");
        labourScopeSummary.innerHTML = `<span class="text-red-600">0</span>`;
        labourScopeList.innerHTML = "";
        return;
      }
      labourScopePanel.classList.remove("hidden");
      labourScopeSummary.textContent = String(safeRows.length);
      labourScopeList.innerHTML = safeRows
        .map(
          (row) =>
            `<span class="inline-flex max-w-full items-center rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11px] font-medium text-slate-700">${row.labour_name || row.labour_id}</span>`,
        )
        .join("");
    };

    const loadResolvedLabours = async () => {
      if (!hasLabourScopePanel) return;
      const labourIds = getSelectedLabourIds();
      const deptIdRaw = String(fields.deptId?.value || "").trim();
      if (!labourIds.length) {
        hideLabourScope();
        return;
      }
      if (!deptIdRaw) {
        renderLabourScope([]);
        return;
      }
      try {
        const params = new URLSearchParams({
          labour_ids: labourIds.join(","),
          dept_id: deptIdRaw,
        });
        const response = await fetch(`${resolvedLaboursPath}?${params.toString()}`, {
          method: "GET",
          headers: { Accept: "application/json" },
          credentials: "same-origin",
        });
        const payload = await response.json().catch(() => ({}));
        if (response.status === 401) {
          window.location.href = "/auth/login";
          return;
        }
        if (!response.ok) {
          renderLabourScope([]);
          return;
        }
        renderLabourScope(payload.rows);
      } catch (err) {
        renderLabourScope([]);
      }
    };

    if (hasLabourScopeAccordion) {
      labourScopeToggle.addEventListener("click", () => {
        const isCollapsed = labourScopeToggle.dataset.collapsed === "true";
        setCollapsedState(labourScopeToggle, labourScopeBody, !isCollapsed);
      });
    }

    if (hasSkuAccordion) {
      skuToggle.addEventListener("click", () => {
        const isCollapsed = skuToggle.dataset.collapsed === "true";
        setCollapsedState(skuToggle, skuBody, !isCollapsed);
      });
    }

    const resetDepartmentOptions = () => {
      if (!fields.deptId) return;
      fields.deptId.innerHTML = `<option value="">${tSelect}</option>`;
      fields.deptId.value = "";
      fields.deptId.dispatchEvent(new Event("change", { bubbles: true }));
    };

    const applyDepartmentOptions = (options, selectedValue = "") => {
      if (!fields.deptId) return;
      const safeOptions = Array.isArray(options) ? options : [];
      const optionHtml = safeOptions
        .map((option) => `<option value="${String(option.value)}">${String(option.label || option.value)}</option>`)
        .join("");
      fields.deptId.innerHTML = `<option value="">${tSelect}</option>${optionHtml}`;
      if (selectedValue && safeOptions.some((opt) => String(opt.value) === String(selectedValue))) {
        fields.deptId.value = String(selectedValue);
      } else {
        fields.deptId.value = "";
      }
    };

    const syncDepartmentOptions = async ({ preserveSelection = true } = {}) => {
      const labourIds = getSelectedLabourIds();
      const labourIdsKey = labourIds.join(",");
      const currentDept = preserveSelection ? String(fields.deptId?.value || "").trim() : "";
      const requestSeq = ++state.deptOptionsSeq;
      if (!labourIds.length) {
        resetDepartmentOptions();
        return;
      }
      try {
        const params = new URLSearchParams({ labour_ids: labourIdsKey });
        const response = await fetch(`${departmentOptionsPath}?${params.toString()}`, {
          method: "GET",
          headers: { Accept: "application/json" },
          credentials: "same-origin",
        });
        const payload = await response.json().catch(() => ({}));
        if (response.status === 401) {
          window.location.href = "/auth/login";
          return;
        }
        if (requestSeq !== state.deptOptionsSeq) return;
        if (modal.classList.contains("hidden")) return;
        if (getSelectedLabourIds().join(",") !== labourIdsKey) return;
        if (!response.ok) {
          resetDepartmentOptions();
          return;
        }
        applyDepartmentOptions(payload.options, currentDept);
      } catch (err) {
        resetDepartmentOptions();
      }
    };

    const resetSkuOptions = () => {
      if (!fields.skuId) return;
      fields.skuId.innerHTML = fields.skuId.multiple ? "" : `<option value="">${tSelect}</option>`;
      if (fields.skuId.multiple) {
        Array.from(fields.skuId.options || []).forEach((option) => {
          option.selected = false;
        });
      } else {
        fields.skuId.value = "";
      }
      fields.skuId.dispatchEvent(new Event("change", { bubbles: true }));
    };

    const applySkuOptions = (options, selectedValues = [], selectedLabel = "") => {
      if (!fields.skuId) return;
      const safeOptions = Array.isArray(options) ? options : [];
      const selectedList = Array.isArray(selectedValues)
        ? selectedValues.map((value) => String(value || "").trim()).filter((value) => value)
        : String(selectedValues || "").trim()
          ? [String(selectedValues).trim()]
          : [];
      const existingValueSet = new Set(safeOptions.map((opt) => String(opt.value)));
      const allOptions = [...safeOptions];
      selectedList.forEach((selectedValue) => {
        if (!existingValueSet.has(String(selectedValue))) {
          allOptions.unshift({
            value: selectedValue,
            label: selectedLabel || selectedValue,
          });
        }
      });
      const optionHtml = allOptions
        .map((option) => `<option value="${String(option.value)}">${String(option.label || option.value)}</option>`)
        .join("");
      fields.skuId.innerHTML = fields.skuId.multiple ? optionHtml : `<option value="">${tSelect}</option>${optionHtml}`;
      if (fields.skuId.multiple) {
        const selectedSet = new Set(selectedList);
        Array.from(fields.skuId.options || []).forEach((option) => {
          option.selected = selectedSet.has(String(option.value));
        });
      } else {
        const selectedValue = selectedList[0] || "";
        if (selectedValue && allOptions.some((opt) => String(opt.value) === String(selectedValue))) {
          fields.skuId.value = String(selectedValue);
        } else {
          fields.skuId.value = "";
        }
      }
      fields.skuId.dispatchEvent(new Event("change", { bubbles: true }));
    };

    const syncSkuReadonlyText = (fallbackLabel = "") => {
      const skuSelect = fieldsByName.sku_id;
      if (!skuReadonlyText || !skuSelect) return;
      const selectedOption = Array.from(skuSelect.selectedOptions || [])[0] || null;
      const optionLabel = selectedOption && selectedOption.textContent ? selectedOption.textContent.trim() : "";
      const label =
        optionLabel ||
        String(fallbackLabel || "").trim() ||
        String(skuSelect.value || "").trim() ||
        String(state.editSkuValue || "").trim() ||
        tSelect;
      skuReadonlyText.textContent = label;
    };

    const syncSkuOptions = async ({ preserveSelection = true, selectedValues = [], selectedLabel = "" } = {}) => {
      const applyOn = String(fields.applyOn?.value || "").trim().toUpperCase();
      const articleType = String(fields.articleType?.value || "").trim().toUpperCase();
      const requestSeq = ++state.skuOptionsSeq;
      const currentSkus = preserveSelection ? getSelectedSkuIds() : [];
      const targetSkus = Array.isArray(selectedValues) && selectedValues.length ? selectedValues : currentSkus;
      if (applyOn !== "ARTICLE") {
        resetSkuOptions();
        return;
      }
      try {
        const params = new URLSearchParams();
        if (articleType) {
          params.set("article_type", articleType);
        }
        const response = await fetch(`${skuOptionsPath}?${params.toString()}`, {
          method: "GET",
          headers: { Accept: "application/json" },
          credentials: "same-origin",
        });
        const payload = await response.json().catch(() => ({}));
        if (response.status === 401) {
          window.location.href = "/auth/login";
          return;
        }
        if (requestSeq !== state.skuOptionsSeq) return;
        if (modal.classList.contains("hidden")) return;
        if (!response.ok) {
          resetSkuOptions();
          return;
        }
        applySkuOptions(payload.options, targetSkus, selectedLabel);
        if (modal.dataset.mode === "edit") {
          syncSkuReadonlyText(selectedLabel || state.editSkuLabel);
        }
      } catch (err) {
        resetSkuOptions();
      }
    };

    const getErrorMessage = (payload, fallback) => {
      if (!payload || typeof payload !== "object") return fallback;
      const message = payload.message || payload.error || payload.detail;
      if (typeof message === "string" && message.trim()) return message.trim();
      return fallback;
    };

    const setFieldLocked = (fieldEl, locked) => {
      if (!fieldEl) return;
      fieldEl.classList.toggle("bg-slate-100", locked);
      fieldEl.classList.toggle("text-slate-500", locked);
      fieldEl.classList.toggle("cursor-not-allowed", locked);
      if (locked) {
        fieldEl.setAttribute("aria-readonly", "true");
        fieldEl.tabIndex = -1;
      } else {
        fieldEl.removeAttribute("aria-readonly");
        fieldEl.removeAttribute("tabindex");
      }
    };

    const applyEditLocks = (mode) => {
      const isEdit = mode === "edit";
      Object.entries(fieldsByName).forEach(([name, fieldEl]) => {
        if (!fieldEl) return;
        setFieldLocked(fieldEl, isEdit && editLockedFields.has(name));
      });
      if (isEdit) {
        state.lockedEditValues = {};
        editLockedFields.forEach((name) => {
          const fieldEl = fieldsByName[name];
          if (!fieldEl) return;
          state.lockedEditValues[name] = String(fieldEl.value || "");
        });
      } else {
        state.lockedEditValues = {};
      }
    };

    const applyEditVisibility = (mode) => {
      const isEdit = mode === "edit";
      Object.keys(fieldsByName).forEach((name) => {
        const wrapper = form.querySelector(`[data-field-wrapper="${name}"]`);
        if (!wrapper) return;
        const controls = wrapper.querySelectorAll("[data-field]");
        if (!isEdit) {
          wrapper.classList.remove("hidden");
          controls.forEach((ctrl) => {
            ctrl.disabled = false;
            if (ctrl.hasAttribute("data-required")) {
              ctrl.setAttribute("required", "required");
            }
          });
          return;
        }
        const shouldShow = editVisibleFields.has(name);
        wrapper.classList.toggle("hidden", !shouldShow);
        controls.forEach((ctrl) => {
          const searchableInput = ctrl
            .closest("[data-searchable-wrapper]")
            ?.querySelector('input[type="text"]');
          if (shouldShow) {
            ctrl.disabled = false;
            if (ctrl.hasAttribute("data-required")) {
              ctrl.setAttribute("required", "required");
            }
            if (searchableInput instanceof HTMLInputElement) {
              searchableInput.disabled = false;
              if (ctrl.hasAttribute("data-required")) {
                searchableInput.setAttribute("required", "required");
              } else {
                searchableInput.removeAttribute("required");
              }
            }
            return;
          }
          ctrl.disabled = false;
          ctrl.removeAttribute("required");
          if (searchableInput instanceof HTMLInputElement) {
            searchableInput.removeAttribute("required");
          }
        });
      });

      const skuWrapper = form.querySelector('[data-field-wrapper="sku_id"]');
      const skuSelect = fieldsByName.sku_id;
      if (skuWrapper && skuSelect) {
        const searchableWrapper = skuSelect.closest("[data-searchable-wrapper]");
        if (!skuReadonlyText) {
          skuReadonlyText = document.createElement("div");
          skuReadonlyText.className =
            "mt-2 w-full rounded-xl border border-slate-200 bg-slate-100 px-4 py-3 text-sm text-slate-700";
          skuReadonlyText.setAttribute("data-sku-readonly", "true");
          skuWrapper.appendChild(skuReadonlyText);
        }
        if (isEdit) {
          syncSkuReadonlyText(state.editSkuLabel);
          skuReadonlyText.classList.remove("hidden");
          skuSelect.classList.add("hidden");
          skuSelect.disabled = true;
          if (searchableWrapper) searchableWrapper.classList.add("hidden");
        } else {
          skuReadonlyText.classList.add("hidden");
          skuSelect.classList.remove("hidden");
          skuSelect.disabled = false;
          if (searchableWrapper) searchableWrapper.classList.remove("hidden");
        }
      }
    };

    const hideModalNotice = () => {
      if (!modalNotice) return;
      modalNotice.textContent = "";
      modalNotice.hidden = true;
    };

    const showModalError = (message) => {
      hideModalNotice();
      if (!modalError) return;
      modalError.textContent = message;
      modalError.hidden = false;
    };

    const hideModalError = () => {
      if (!modalError) return;
      modalError.textContent = "";
      modalError.hidden = true;
    };

    const showModalNotice = ({ message, linkHref = "", linkLabel = "" }) => {
      if (!modalNotice) return;
      hideModalError();
      modalNotice.textContent = "";
      const textNode = document.createTextNode(message || "");
      modalNotice.appendChild(textNode);
      if (linkHref && linkLabel) {
        modalNotice.appendChild(document.createTextNode(" "));
        const anchor = document.createElement("a");
        anchor.href = linkHref;
        anchor.className = "font-semibold underline";
        anchor.textContent = linkLabel;
        modalNotice.appendChild(anchor);
      }
      modalNotice.hidden = false;
    };

    const formatSaveSummary = (created, updated) =>
      tSaveSummaryTemplate
        .replace("{created}", String(created))
        .replace("{updated}", String(updated));

    const setPanelVisibility = () => {
      if (modal.dataset.mode !== "create" || !isBulkApplyOn()) {
        panel.classList.add("hidden");
        return;
      }
      panel.classList.remove("hidden");
    };

    const loadingIcon = `<svg class="animate-spin inline -mt-0.5 mr-2 h-4 w-4 text-slate-500" style="animation: spin 1s linear infinite;" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;

    const renderEmpty = (message, isLoading = false) => {
      const icon = isLoading ? loadingIcon : "";
      // Added py-6 to give the spinner some nice breathing room
      tbody.innerHTML = `<tr><td class="px-2 py-6 text-center text-slate-500" colspan="4">${icon}${message || tNoEntries}</td></tr>`;
    };

    // A stored rate can be in a different unit than the one being entered
    // (e.g. an existing Per Pair rate while the form is on Per Dozen). Label
    // it so the previous value cannot be read as the wrong unit.
    const previousRateLabel = (row) => {
      if (row.previous_rate == null) return tNoPrevious;
      const value = Number(row.previous_rate).toFixed(2);
      const stored = String(row.previous_rate_type || "").trim().toUpperCase();
      const selected = String(fields.rateType?.value || "").trim().toUpperCase();
      if (!stored || stored === selected) return value;
      const unit = stored === "PER_DOZEN" ? tPerDozen : stored === "PER_PAIR" ? tPerPair : stored;
      return `${value} <span class="text-[10px] text-slate-500">(${unit})</span>`;
    };

    // The grid only ever shows ~12 rows (the scroller is max-h-72), but a
    // group/flat scope resolves to thousands of articles. Painting every one of
    // them cost ~0.7s per preview and ~150ms per keystroke on the header rate
    // (5,000 rows = 33,000 nodes, 5,000 of them number inputs, each with its own
    // spinner shadow DOM). Only the visible window is rendered now; two spacer
    // rows hold the scrollbar at full height. state.rows stays complete —
    // Save posts from it, so windowing the DOM must never window the data.
    const ROW_OVERSCAN = 8;
    const FALLBACK_ROW_HEIGHT = 30;
    const scroller = tbody.closest(".overflow-auto") || tbody.parentElement;

    const rowHtml = (row, idx) => {
      const previous = previousRateLabel(row);
      const newRate = row.new_rate == null ? "" : Number(row.new_rate).toFixed(2);
      // whitespace-nowrap keeps every row the same height, which is what makes
      // the spacer arithmetic below exact. The scroller already scrolls sideways.
      return `
        <tr data-labour-rate-row="${idx}">
          <td class="px-2 py-1.5 text-slate-700 whitespace-nowrap">${row.sku_code || ""}</td>
          <td class="px-2 py-1.5 text-slate-700 whitespace-nowrap">${row.item_name || ""}</td>
          <td class="px-2 py-1.5 text-slate-700 whitespace-nowrap">${previous}</td>
          <td class="px-2 py-1.5 text-slate-700">
            <input
              class="w-28 rounded-md border border-slate-200 bg-white px-2 py-1 text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-accent/30"
              type="number"
              min="0"
              step="0.01"
              data-labour-rate-row-rate
              data-labour-rate-row-index="${idx}"
              value="${newRate}"
            />
          </td>
        </tr>
      `;
    };

    const spacerHtml = (height) =>
      height > 0 ? `<tr aria-hidden="true"><td colspan="4" style="height:${height}px;padding:0;border:0"></td></tr>` : "";

    // Measured off the first painted row so the spacers match whatever the
    // theme/zoom actually produces, rather than a hard-coded guess.
    const measureRowHeight = () => {
      const sample = tbody.querySelector("[data-labour-rate-row]");
      if (!sample) return;
      const height = sample.getBoundingClientRect().height;
      if (height > 0) state.rowHeight = height;
    };

    const visibleRange = () => {
      const total = state.rows.length;
      const rowHeight = state.rowHeight || FALLBACK_ROW_HEIGHT;
      const viewport = scroller ? scroller.clientHeight || 0 : 0;
      // clientHeight is 0 while the modal is still hidden. Render a small block
      // rather than the whole list — the spacers keep the scrollbar honest and
      // the first scroll repaints against a real viewport.
      if (!viewport) return { start: 0, end: Math.min(total, 40) };
      const scrollTop = scroller.scrollTop || 0;
      const start = Math.max(0, Math.floor(scrollTop / rowHeight) - ROW_OVERSCAN);
      const end = Math.min(total, Math.ceil((scrollTop + viewport) / rowHeight) + ROW_OVERSCAN);
      return { start, end: Math.max(end, start) };
    };

    const paintWindow = ({ force = false } = {}) => {
      const total = state.rows.length;
      if (!total) return;
      const { start, end } = visibleRange();
      if (!force && start === state.windowStart && end === state.windowEnd) return;

      // Re-rendering blows away the focused input, so put the caret back if the
      // row the user was typing in is still on screen.
      const active = document.activeElement;
      const focusedIndex =
        active instanceof HTMLInputElement && active.hasAttribute("data-labour-rate-row-rate")
          ? Number(active.getAttribute("data-labour-rate-row-index"))
          : null;
      const selectionStart = focusedIndex == null ? null : active.selectionStart;
      const selectionEnd = focusedIndex == null ? null : active.selectionEnd;

      const rowHeight = state.rowHeight || FALLBACK_ROW_HEIGHT;
      let html = spacerHtml(start * rowHeight);
      for (let idx = start; idx < end; idx += 1) {
        html += rowHtml(state.rows[idx], idx);
      }
      html += spacerHtml((total - end) * rowHeight);
      tbody.innerHTML = html;
      state.windowStart = start;
      state.windowEnd = end;

      if (focusedIndex != null && focusedIndex >= start && focusedIndex < end) {
        const restored = tbody.querySelector(`[data-labour-rate-row-index="${focusedIndex}"]`);
        if (restored instanceof HTMLInputElement) {
          restored.focus();
          if (selectionStart != null && selectionEnd != null) {
            try {
              restored.setSelectionRange(selectionStart, selectionEnd);
            } catch (err) {
              /* number inputs reject setSelectionRange in some browsers */
            }
          }
        }
      }
    };

    const renderRows = () => {
      summary.textContent = String(state.rows.length);
      state.windowStart = -1;
      state.windowEnd = -1;
      if (!state.rows.length) {
        renderEmpty(tNoEntries);
        return;
      }
      if (scroller) scroller.scrollTop = 0;
      // First paint with the previous (or fallback) height, measure, then repaint
      // so the spacers are exact from the very first frame.
      paintWindow({ force: true });
      const before = state.rowHeight;
      measureRowHeight();
      if (state.rowHeight !== before) paintWindow({ force: true });
    };

    if (scroller) {
      scroller.addEventListener(
        "scroll",
        () => {
          if (!state.rows.length) return;
          if (state.scrollFrame) return;
          state.scrollFrame = window.requestAnimationFrame(() => {
            state.scrollFrame = null;
            paintWindow();
          });
        },
        { passive: true },
      );
    }

    const clearRows = (message = tSelectTarget, isLoading = false) => {
      state.rows = [];
      state.windowStart = -1;
      state.windowEnd = -1;
      renderEmpty(message, isLoading);
      if (isLoading) {
        summary.innerHTML = `${loadingIcon} ${message}`;
      } else {
        summary.textContent = "0";
      }
    };

    // state.rows is what Save posts, so it has to track the header rate on every
    // keystroke. Repainting the grid does not: with a few thousand affected
    // articles, querySelectorAll + a .value write per row on each keystroke made
    // typing a rate visibly lag. Update the data now, coalesce the DOM writes.
    // Only the windowed rows exist in the DOM, so this is a handful of writes.
    const syncHeaderRateInputs = () => {
      const headerRate = String(fields.rateValue?.value || "").trim();
      tbody.querySelectorAll("[data-labour-rate-row-rate]").forEach((input) => {
        input.value = headerRate;
      });
    };

    const applyHeaderRateToRows = ({ deferRepaint = false } = {}) => {
      const headerRate = String(fields.rateValue?.value || "").trim();
      if (!state.rows.length) return;
      state.rows.forEach((row) => {
        row.new_rate = headerRate;
      });
      if (!deferRepaint) {
        syncHeaderRateInputs();
        return;
      }
      if (state.headerRateRepaintTimer) {
        window.clearTimeout(state.headerRateRepaintTimer);
      }
      state.headerRateRepaintTimer = window.setTimeout(() => {
        state.headerRateRepaintTimer = null;
        syncHeaderRateInputs();
      }, 120);
    };

    const getPreviewQuery = () => {
      const labourIds = getSelectedLabourIds();
      const deptId = String(fields.deptId?.value || "").trim();
      const applyOn = String(fields.applyOn?.value || "").trim().toUpperCase();
      const skuIds = getSelectedSkuIds();
      const subgroupIds = getSelectedSubgroupIds();
      const groupIds = getSelectedGroupIds();
      const articleType = String(fields.articleType?.value || "").trim();
      const rateType = String(fields.rateType?.value || "").trim();

      if (!labourIds.length || !deptId || !applyOn || !articleType || !rateType) return null;
      if (applyOn === "ARTICLE" && !skuIds.length) return null;
      if (applyOn === "SUBGROUP" && !subgroupIds.length) return null;
      if (applyOn === "GROUP" && !groupIds.length) return null;

      const params = new URLSearchParams({
        labour_ids: labourIds.join(","),
        dept_id: deptId,
        apply_on: applyOn,
        article_type: articleType,
        rate_type: rateType,
      });
      if (applyOn === "ARTICLE" && skuIds.length) {
        params.set("article_ids", skuIds.join(","));
        params.set("article_id", skuIds[0]);
      }
      if (skuIds.length) {
        params.set("sku_ids", skuIds.join(","));
        params.set("sku_id", skuIds[0]);
      }
      if (subgroupIds.length) {
        params.set("subgroup_ids", subgroupIds.join(","));
        params.set("subgroup_id", subgroupIds[0]);
      }
      if (groupIds.length) {
        params.set("group_ids", groupIds.join(","));
        params.set("group_id", groupIds[0]);
      }
      return params;
    };

    const loadPreview = async () => {
      setPanelVisibility();
      if (modal.dataset.mode !== "create") {
        clearRows(tSelectTarget);
        return;
      }
      hideModalError();
      hideModalNotice();

      if (!getSelectedLabourIds().length) {
        clearRows(tSelectLabour);
        return;
      }
      if (!fields.deptId?.value) {
        clearRows(tSelectDepartment);
        return;
      }
      const applyOn = String(fields.applyOn?.value || "").trim().toUpperCase();
      if (!applyOn) {
        clearRows(tSelectTarget);
        return;
      }
      if (applyOn === "ARTICLE" && !getSelectedSkuIds().length) {
        clearRows(tSelectSku);
        return;
      }
      if (applyOn === "SUBGROUP" && !getSelectedSubgroupIds().length) {
        clearRows(tSelectSubgroup);
        return;
      }
      if (applyOn === "GROUP" && !getSelectedGroupIds().length) {
        clearRows(tSelectGroup);
        return;
      }
      if (!fields.articleType?.value) {
        clearRows(tSelectArticleType);
        return;
      }
      if (!fields.rateType?.value) {
        clearRows(tSelectRateType);
        return;
      }

      const params = getPreviewQuery();
      if (!params) {
        clearRows(tSelectTarget);
        return;
      }

      const currentSeq = ++state.requestSeq;
      state.loading = true;
      if (!state.rows.length) {
        renderEmpty(tLoading, true); // <-- Pass true to show the icon in the table
      }
      summary.innerHTML = `${loadingIcon} ${tLoading}`; // <-- Show the icon in the summary text
      try {
        const response = await fetch(`${basePath}/bulk-preview?${params.toString()}`, {
          method: "GET",
          headers: { Accept: "application/json" },
          credentials: "same-origin",
        });
        const payload = await response.json().catch(() => ({}));
        if (currentSeq !== state.requestSeq) return;
        state.loading = false;
        if (response.status === 401) {
          window.location.href = "/auth/login";
          return;
        }
        if (!response.ok) {
          clearRows(getErrorMessage(payload, tLoadFailed));
          return;
        }
        state.rows = Array.isArray(payload.rows) ? payload.rows : [];
        applyHeaderRateToRows();
        renderRows();
      } catch (err) {
        state.loading = false;
        clearRows(tNetworkError);
      }
    };

    const schedulePreview = () => {
      if (state.debounceTimer) window.clearTimeout(state.debounceTimer);
      state.debounceTimer = window.setTimeout(loadPreview, 200);
    };

    const resetSelections = () => {
      state.deptOptionsSeq += 1;
      state.skuOptionsSeq += 1;
      if (fields.labourId) {
        clearSelectField(fields.labourId);
      }
      resetDepartmentOptions();
      resetSkuOptions();
      if (fields.articleType) {
        clearSelectField(fields.articleType);
      }
      if (fields.applyOn) {
        clearSelectField(fields.applyOn);
      }
      if (fields.skuId) {
        clearSelectField(fields.skuId);
      }
      if (fields.subgroupId) {
        clearSelectField(fields.subgroupId);
      }
      if (fields.groupId) {
        clearSelectField(fields.groupId);
      }
      if (fields.rateType) {
        clearSelectField(fields.rateType);
      }
      if (fields.rateValue) fields.rateValue.value = "";
      hideModalError();
      hideModalNotice();
      hideLabourScope();
      if (hasLabourScopeAccordion) {
        setCollapsedState(labourScopeToggle, labourScopeBody, true);
      }
      if (hasSkuAccordion) {
        setCollapsedState(skuToggle, skuBody, true);
      }
      clearRows(tSelectTarget);
      setPanelVisibility();
    };

    form.addEventListener("input", (event) => {
      const target = event.target;
      if (!target) return;
      if (target.hasAttribute("data-labour-rate-row-rate")) {
        const index = Number(target.getAttribute("data-labour-rate-row-index"));
        if (!Number.isInteger(index) || !state.rows[index]) return;
        // A per-row edit outranks a header rate still waiting to be painted.
        if (state.headerRateRepaintTimer) {
          window.clearTimeout(state.headerRateRepaintTimer);
          state.headerRateRepaintTimer = null;
        }
        state.rows[index].new_rate = target.value;
        return;
      }
      if (target.matches("[data-field='rate_value']")) {
        applyHeaderRateToRows({ deferRepaint: true });
      }
    });

    form.addEventListener("keydown", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;
      if (!target.hasAttribute("data-labour-rate-row-rate")) return;
      if (event.key !== "Enter" && event.key !== "ArrowDown") return;

      // Walk state.rows, not the DOM: only the visible window is rendered, so
      // the next row may not exist yet. Scroll it into view, repaint, then focus.
      const currentIndex = Number(target.getAttribute("data-labour-rate-row-index"));
      if (!Number.isInteger(currentIndex)) return;
      const nextIndex = currentIndex + 1;
      if (nextIndex >= state.rows.length) return;

      event.preventDefault();
      if (scroller) {
        const rowHeight = state.rowHeight || FALLBACK_ROW_HEIGHT;
        const top = nextIndex * rowHeight;
        const bottom = top + rowHeight;
        const viewTop = scroller.scrollTop;
        const viewBottom = viewTop + scroller.clientHeight;
        if (bottom > viewBottom) scroller.scrollTop = bottom - scroller.clientHeight;
        else if (top < viewTop) scroller.scrollTop = top;
        paintWindow();
      }
      const next = tbody.querySelector(`[data-labour-rate-row-index="${nextIndex}"]`);
      if (!(next instanceof HTMLInputElement)) return;
      next.focus();
      next.select();
    });

    form.addEventListener(
      "wheel",
      (event) => {
        const target = event.target;
        if (!(target instanceof HTMLInputElement)) return;
        if (target.type !== "number") return;
        if (document.activeElement !== target) return;
        event.preventDefault();
      },
      { passive: false },
    );

    form.addEventListener("change", (event) => {
      const target = event.target;
      if (!target) return;
      const fieldName = target.getAttribute("data-field");
      if (modal.dataset.mode === "edit" && fieldName && editLockedFields.has(fieldName)) {
        const lockedValue = state.lockedEditValues[fieldName];
        if (typeof lockedValue !== "undefined" && String(target.value || "") !== String(lockedValue)) {
          target.value = lockedValue;
        }
        return;
      }
      if (target.matches("[data-field='labour_id']")) {
        syncDepartmentOptions({ preserveSelection: false }).then(() => {
          loadResolvedLabours();
          schedulePreview();
        });
        return;
      }
      if (target.matches("[data-field='apply_on'], [data-field='article_type']")) {
        syncSkuOptions({ preserveSelection: false }).then(() => {
          schedulePreview();
        });
        return;
      }
      if (
        target.matches(
          "[data-field='dept_id'], [data-field='apply_on'], [data-field='sku_id'], [data-field='subgroup_id'], [data-field='group_id'], [data-field='article_type'], [data-field='rate_type']",
        )
      ) {
        if (target.matches("[data-field='dept_id']")) {
          loadResolvedLabours();
        }
        schedulePreview();
      }
    });

    document.addEventListener("modal:opened", (event) => {
      state.requestSeq += 1;
      if (typeof window.initDataMultiSelects === "function") {
        window.initDataMultiSelects(form);
      }
      if (fields.rateValue instanceof HTMLInputElement) {
        // Keep decimal-rate edits valid even when browser defaults reset number-step constraints.
        fields.rateValue.setAttribute("step", "0.01");
        fields.rateValue.setAttribute("min", "0");
      }
      const modalMode = event?.detail?.mode || modal.dataset.mode || "create";
      let editSkuValue = "";
      let editSkuLabel = "";
      const currentId = String(modal.dataset.currentId || "").trim();
      const editBtn = currentId ? document.querySelector(`[data-edit][data-id="${currentId}"]`) : null;
      if (modalMode === "edit") {
        editSkuValue = String(editBtn?.getAttribute("data-sku_id") || "").trim();
        editSkuLabel = String(editBtn?.getAttribute("data-sku_code") || "").trim();
        state.editSkuLabel = editSkuLabel;
        state.editSkuValue = editSkuValue;
      } else {
        state.editSkuLabel = "";
        state.editSkuValue = "";
      }
      if (modalMode === "edit" && fields.applyOn && editBtn) {
        fieldsByName.apply_on.value =
          String(editBtn.getAttribute("data-apply_on") || "ARTICLE")
            .trim()
            .toUpperCase() || "ARTICLE";
        fieldsByName.apply_on.dispatchEvent(new Event("change", { bubbles: true }));
      }
      applyEditLocks(modalMode);
      applyEditVisibility(modalMode);
      setPanelVisibility();
      if (modalMode === "create" && fields.deptId) {
        fields.deptId.value = "";
        fields.deptId.dispatchEvent(new Event("change", { bubbles: true }));
      }
      if (modalMode === "create") {
        syncSkuOptions({ preserveSelection: false });
        syncDepartmentOptions({ preserveSelection: false }).then(() => {
          loadResolvedLabours();
          schedulePreview();
        });
      } else if (modalMode === "edit") {
        syncSkuOptions({
          preserveSelection: false,
          selectedValues: editSkuValue ? [editSkuValue] : [],
          selectedLabel: editSkuLabel,
        });
      }
      if (hasLabourScopeAccordion) {
        setCollapsedState(labourScopeToggle, labourScopeBody, true);
      }
      if (hasSkuAccordion) {
        setCollapsedState(skuToggle, skuBody, true);
      }
    });

    const modalObserver = new MutationObserver(() => {
      if (modal.classList.contains("hidden")) {
        resetSelections();
      }
    });
    modalObserver.observe(modal, { attributes: true, attributeFilter: ["class"] });

    form.addEventListener(
      "submit",
      async (event) => {
        if (modal.dataset.mode !== "create") return;
        event.preventDefault();
        event.stopImmediatePropagation();
        hideModalError();
        hideModalNotice();

        const labourIds = getSelectedLabourIds();
        const deptId = String(fields.deptId?.value || "").trim();
        const applyOn = String(fields.applyOn?.value || "").trim().toUpperCase();
        const skuIds = getSelectedSkuIds();
        const subgroupIds = getSelectedSubgroupIds();
        const groupIds = getSelectedGroupIds();
        const articleType = String(fields.articleType?.value || "").trim();
        const rateType = String(fields.rateType?.value || "").trim();
        if (!labourIds.length) {
          showModalError(tSelectLabour);
          return;
        }
        if (!fields.deptId?.value) {
          showModalError(tSelectDepartment);
          return;
        }
        if (!applyOn) {
          showModalError(tSelectTarget);
          return;
        }
        if (applyOn === "ARTICLE" && !skuIds.length) {
          showModalError(tSelectSku);
          return;
        }
        if (applyOn === "SUBGROUP" && !subgroupIds.length) {
          showModalError(tSelectSubgroup);
          return;
        }
        if (applyOn === "GROUP" && !groupIds.length) {
          showModalError(tSelectGroup);
          return;
        }
        if (!articleType) {
          showModalError(tSelectArticleType);
          return;
        }
        if (!fields.rateType?.value) {
          showModalError(tSelectRateType);
          return;
        }
        if (!state.rows.length) {
          showModalError(tNoTargetSkus || tSelectTarget);
          return;
        }

        const payload = {
          _csrf: csrfToken,
          labour_ids: labourIds,
          dept_id: deptId,
          apply_on: applyOn,
          article_id: skuIds[0] || null,
          article_ids: skuIds,
          sku_id: skuIds[0] || null,
          sku_ids: skuIds,
          subgroup_id: subgroupIds[0] || null,
          subgroup_ids: subgroupIds,
          group_id: groupIds[0] || null,
          group_ids: groupIds,
          article_type: articleType,
          rate_type: rateType,
          rows: state.rows.map((row) => ({
            sku_id: row.sku_id,
            subgroup_id: row.subgroup_id || null,
            group_id: row.group_id || null,
            new_rate: row.new_rate,
          })),
        };

        if (!Array.isArray(payload.labour_ids) || !payload.labour_ids.length || !payload.dept_id || !payload.apply_on || !payload.article_type || !payload.rate_type) {
          showModalError(tRequiredFields);
          return;
        }

        try {
          const response = await fetch(`${basePath}/bulk-upsert`, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "x-csrf-token": csrfToken,
              Accept: "application/json",
            },
            credentials: "same-origin",
            body: JSON.stringify(payload),
          });

          const result = await response.json().catch(() => ({}));
          if (response.status === 401) {
            window.location.href = "/auth/login";
            return;
          }
          if (!response.ok) {
            showModalError(getErrorMessage(result, tUnableSave));
            return;
          }

          if (result.queued) {
            showModalNotice({
              message: result.message || tSaved,
              linkHref: result.approvals_url || "",
              linkLabel: result.approvals_url ? tViewPendingApproval : "",
            });
            return;
          }

          const createdCount = Number(result.created || 0);
          const updatedCount = Number(result.updated || 0);
          showModalNotice({
            message: `${result.message || tSaved} ${formatSaveSummary(createdCount, updatedCount)}`,
          });
          window.setTimeout(() => {
            window.location.href = basePath;
          }, 1200);
        } catch (err) {
          showModalError(tNetworkError);
        }
      },
      true,
    );

    setPanelVisibility();
    if (typeof window.initDataMultiSelects === "function") {
      window.initDataMultiSelects(form);
    }
    hideLabourScope();
    if (hasLabourScopeAccordion) {
      setCollapsedState(labourScopeToggle, labourScopeBody, true);
    }
    if (hasSkuAccordion) {
      setCollapsedState(skuToggle, skuBody, true);
    }
    clearRows(tSelectTarget);
  })();
</script>
<% } %>
<% if (page.scopeKey === "hr_payroll.commissions") { %>
<button
  type="button"
  data-edit
  data-commission-proxy-edit
  style="position:absolute;width:0;height:0;overflow:hidden;pointer-events:none"
  tabindex="-1"
  aria-hidden="true"
  data-id=""
  data-employee_id=""
  data-commission_type=""
  data-apply_on=""
  data-sku_id=""
  data-subgroup_id=""
  data-group_id=""
  data-rate_type=""
  data-value=""
  data-status=""
  data-reverse_on_returns=""
></button>
<script>
  (function () {
    const basePath = "<%= basePath %>";
    const csrfToken = "<%= csrfToken %>";
    const tAll = "<%- (t('all') || 'ALL').replace(/"/g, '&quot;') %>";
    const tYes = "<%- (t('yes') || 'YES').replace(/"/g, '&quot;') %>";
    const tNo = "<%- (t('no') || 'NO').replace(/"/g, '&quot;') %>";
    const tNone = "<%- (t('none') || '-').replace(/"/g, '&quot;') %>";
    const tLoading = "<%- (t('loading') || 'Loading…').replace(/"/g, '&quot;') %>";
    const tError = "<%- (t('error_loading') || 'Failed to load. Click to retry.').replace(/"/g, '&quot;') %>";
    const tEdit = "<%- (t('edit') || 'Edit').replace(/"/g, '&quot;') %>";
    const tDelete = "<%- (t('delete') || 'Delete').replace(/"/g, '&quot;') %>";
    const canEdit = <%= canEdit ? 'true' : 'false' %>;
    const canDelete = <%= canDelete ? 'true' : 'false' %>;
    const canHardDelete = <%= canHardDelete ? 'true' : 'false' %>;
    const colspan = <%= displayColumns.length + 2 %>;
    const tCommTypes = {
      SALESMAN_SALE: "<%- (t('commission_type_salesman_sale') || 'Salesman Sale').replace(/"/g, '&quot;') %>",
      BRANCH_SALE:   "<%- (t('commission_type_branch_sale') || 'Branch Sale').replace(/"/g, '&quot;') %>",
      TRANSFER:      "<%- (t('commission_type_transfer') || 'Transfer').replace(/"/g, '&quot;') %>",
      PARTY:         "<%- (t('commission_type_party') || 'Party').replace(/"/g, '&quot;') %>",
      PRODUCTION_FG:  "<%- (t('commission_type_production_fg') || 'Production (FG)').replace(/"/g, '&quot;') %>",
      PRODUCTION_SFG: "<%- (t('commission_type_production_sfg') || 'Production (SFG)').replace(/"/g, '&quot;') %>",
    };
    const commTypeClass = {
      SALESMAN_SALE:  "border-blue-200 bg-blue-50 text-blue-700",
      BRANCH_SALE:    "border-violet-200 bg-violet-50 text-violet-700",
      TRANSFER:       "border-amber-200 bg-amber-50 text-amber-700",
      PARTY:          "border-emerald-200 bg-emerald-50 text-emerald-700",
      PRODUCTION_FG:  "border-sky-200 bg-sky-50 text-sky-700",
      PRODUCTION_SFG: "border-teal-200 bg-teal-50 text-teal-700",
    };

    const esc = (s) =>
      String(s == null ? "" : s)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");

    const rowCache = {};
    const proxyBtn = document.querySelector("[data-commission-proxy-edit]");
    const tableBody = document.querySelector("[data-table-body]");
    if (!tableBody) return;

    const renderRow = (row, idx) => {
      const ct = String(row.commission_type || "").toUpperCase();
      const ctClass = commTypeClass[ct] || "border-slate-200 bg-white text-slate-600";
      const ctLabel = tCommTypes[ct] || row.commission_type || "";
      const selectorDisplay = row.selector_display || tAll;

      const editAttrs = [
        `data-id="${esc(row.id)}"`,
        `data-employee_id="${esc(row.employee_id)}"`,
        `data-commission_type="${esc(row.commission_type)}"`,
        `data-apply_on="${esc(row.apply_on)}"`,
        `data-sku_id="${esc(row.sku_id)}"`,
        `data-subgroup_id="${esc(row.subgroup_id)}"`,
        `data-group_id="${esc(row.group_id)}"`,
        `data-rate_type="${esc(row.rate_type)}"`,
        `data-value="${esc(row.value)}"`,
        `data-status="${esc(row.status)}"`,
        `data-reverse_on_returns="${esc(row.reverse_on_returns)}"`,
      ].join(" ");

      const editBtn = canEdit
        ? `<button type="button" data-commission-lazy-edit ${editAttrs}
              class="inline-flex items-center justify-center rounded-md border border-slate-200 bg-white p-2 text-slate-600 transition hover:border-slate-300 hover:text-slate-900 cursor-pointer"
              title="${tEdit}">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 20h9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
           </button>`
        : "";

      const toggleBtn = canDelete
        ? `<button type="button" data-commission-lazy-toggle
              data-toggle-action="${basePath}/${esc(row.id)}/toggle"
              data-row-active="${row.is_active ? "true" : "false"}"
              class="inline-flex items-center justify-center rounded-md border border-slate-200 bg-white p-2 text-slate-600 transition hover:border-slate-300 hover:text-slate-900 cursor-pointer"
              title="${row.is_active ? '<%- (t("deactivate") || "Deactivate").replace(/"/g, "&quot;") %>' : '<%- (t("activate") || "Activate").replace(/"/g, "&quot;") %>'}">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                ${row.is_active
                  ? '<path d="M6 12h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />'
                  : '<path d="M12 5v14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /><path d="M5 12h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />'}
              </svg>
           </button>`
        : "";

      const deleteBtn = canHardDelete
        ? `<button type="button" data-commission-lazy-delete
              data-delete-action="${basePath}/${esc(row.id)}/delete"
              class="inline-flex items-center justify-center rounded-md border border-rose-200 bg-rose-50 p-2 text-rose-600 transition hover:border-rose-300 hover:text-rose-700 cursor-pointer"
              title="${tDelete}">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M4 7h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                <path d="M9 7V5h6v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                <path d="M10 11v6M14 11v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
              </svg>
           </button>`
        : "";

      return `<tr
          class="hover:bg-amber-50/40 odd:bg-white even:bg-slate-50/40"
          data-lazy-injected="true"
          data-active="${row.is_active ? "true" : "false"}"
          data-group-name="${esc(row.employee_name || "")}"
          data-commission-type="${esc(ct)}"
          data-rate-type="${esc(row.rate_type || "")}"
          data-rate-amount="${esc(row.value ?? "")}"
          data-commission-basis="${esc(row.commission_basis || "")}"
          data-apply-on="${esc(row.apply_on || "")}"
        >
          <td class="px-4 py-3 text-slate-700">${idx + 1}</td>
          <td class="px-4 py-3 text-slate-700">${esc(row.employee_name || tNone)}</td>
          <td class="px-4 py-3">
            <span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.12em] ${ctClass}">
              ${esc(ctLabel)}
            </span>
          </td>
          <td class="px-4 py-3 text-slate-700">${esc(selectorDisplay)}</td>
          <td class="px-4 py-3 text-slate-700">${esc(row.value ?? tNone)}</td>
          <td class="px-4 py-3">
            <span class="inline-flex items-center rounded-full border border-slate-200 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.12em] text-slate-600">
              ${row.reverse_on_returns ? tYes : tNo}
            </span>
          </td>
          <td class="px-4 py-3">
            <div class="hidden items-center gap-2 lg:flex">
              ${editBtn}
              ${toggleBtn}
              ${deleteBtn}
            </div>
          </td>
        </tr>`;
    };

    // Show or hide all injected rows belonging to a group
    const toggleInjectedRows = (groupKey, show) => {
      tableBody.querySelectorAll("[data-lazy-injected]").forEach((r) => {
        if (r.dataset.groupName === groupKey) r.style.display = show ? "" : "none";
      });
    };

    // Fetch real rows and inject them after the placeholder row
    const loadGroupRows = async (placeholder, header) => {
      if (placeholder.dataset.lazyLoading === "true") return;
      placeholder.dataset.lazyLoading = "true";

      const employeeId = placeholder.dataset.employeeId;
      const groupKey = placeholder.dataset.groupName;

      const spinnerRow = document.createElement("tr");
      spinnerRow.dataset.lazyInjected = "true";
      spinnerRow.dataset.groupName = groupKey;
      spinnerRow.innerHTML = `<td colspan="${colspan}" class="px-4 py-4 text-center text-sm text-slate-400">${tLoading}</td>`;
      placeholder.after(spinnerRow);

      try {
        if (!rowCache[employeeId]) {
          const resp = await fetch(
            `${basePath}/employee-rules?employee_id=${encodeURIComponent(employeeId)}`,
            { headers: { Accept: "application/json" } },
          );
          if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
          const json = await resp.json();
          rowCache[employeeId] = json.rows || [];
        }
        spinnerRow.remove();
        const rows = rowCache[employeeId];
        let insertAfter = placeholder;
        rows.forEach((row, idx) => {
          const tmp = document.createElement("table");
          tmp.innerHTML = `<tbody>${renderRow(row, idx)}</tbody>`;
          const el = tmp.querySelector("tr");
          if (el) { insertAfter.after(el); insertAfter = el; }
        });
        placeholder.dataset.lazyLoaded = "true";
        delete placeholder.dataset.lazyLoading;
        // If group was closed while loading, hide the injected rows immediately
        if (header.dataset.groupOpen !== "true") {
          toggleInjectedRows(groupKey, false);
        }
        // Update badge in the group header to show real count
        const badge = header.querySelector(".rounded-full");
        if (badge && placeholder.dataset.lazyCount) {
          const parts = badge.textContent.trim().split(" ");
          badge.textContent = placeholder.dataset.lazyCount + " " + parts.slice(1).join(" ");
        }
      } catch (err) {
        console.error("[commission-lazy]", err);
        delete placeholder.dataset.lazyLoading;
        spinnerRow.innerHTML = `<td colspan="${colspan}" class="px-4 py-4 text-center text-sm text-rose-500 cursor-pointer">${tError}</td>`;
        spinnerRow.addEventListener("click", () => { spinnerRow.remove(); loadGroupRows(placeholder, header); }, { once: true });
      }
    };

    // Wire up lazy-load behaviour on a group header built by basic-info-utils.ejs
    const observedHeaders = new WeakSet();

    const setupGroupHeader = (header) => {
      if (observedHeaders.has(header)) return;
      observedHeaders.add(header);

      const groupKey = header.dataset.groupKey;

      // Find the placeholder row for this group
      const placeholder = Array.from(tableBody.querySelectorAll("[data-row][data-lazy-count]"))
        .find((r) => r.dataset.groupName === groupKey);

      // Update the "1 RATES" badge to the real count immediately
      if (placeholder?.dataset.lazyCount) {
        const badge = header.querySelector(".rounded-full");
        if (badge) {
          const parts = badge.textContent.trim().split(" ");
          badge.textContent = placeholder.dataset.lazyCount + " " + parts.slice(1).join(" ");
        }
      }

      // If header was already open when re-created (search re-ran), restore visible injected rows
      if (header.dataset.groupOpen === "true" && placeholder?.dataset.lazyLoaded === "true") {
        toggleInjectedRows(groupKey, true);
      }

      // React to expand/collapse driven by basic-info-utils.ejs click handler
      new MutationObserver(() => {
        if (!placeholder) return;
        const isOpen = header.dataset.groupOpen === "true";
        if (isOpen) {
          if (placeholder.dataset.lazyLoaded !== "true") {
            loadGroupRows(placeholder, header);
          } else {
            toggleInjectedRows(groupKey, true);
          }
        } else {
          toggleInjectedRows(groupKey, false);
        }
      }).observe(header, { attributes: true, attributeFilter: ["data-group-open"] });
    };

    // Watch for group-header rows added or removed by applyLabourRatesGrouping
    new MutationObserver((mutations) => {
      mutations.forEach((m) => {
        m.addedNodes.forEach((node) => {
          if (node.nodeType === 1 && node.classList?.contains("group-header")) {
            setupGroupHeader(node);
          }
        });
        // When a group header is removed (search filtered it out), hide its injected rows
        m.removedNodes.forEach((node) => {
          if (node.nodeType === 1 && node.classList?.contains("group-header")) {
            const gk = node.dataset.groupKey;
            if (gk) toggleInjectedRows(gk, false);
          }
        });
      });
    }).observe(tableBody, { childList: true });

    // Handle any group headers already present (e.g. after applyFilters re-run)
    tableBody.querySelectorAll(".group-header[data-group-key]").forEach(setupGroupHeader);

    // Event delegation for edit / toggle / delete on lazily-injected rows
    tableBody.addEventListener("click", async (event) => {
      const editBtn = event.target.closest("[data-commission-lazy-edit]");
      if (editBtn && proxyBtn) {
        event.preventDefault();
        editBtn.getAttributeNames().forEach((attr) => {
          if (attr.startsWith("data-")) proxyBtn.setAttribute(attr, editBtn.getAttribute(attr) ?? "");
        });
        proxyBtn.click();
        return;
      }

      const toggleBtn = event.target.closest("[data-commission-lazy-toggle]");
      if (toggleBtn) {
        const action = toggleBtn.dataset.toggleAction;
        if (!action) return;
        try {
          toggleBtn.disabled = true;
          const resp = await fetch(action, { method: "POST", headers: { "X-CSRF-Token": csrfToken } });
          if (resp.ok) window.location.reload();
          else toggleBtn.disabled = false;
        } catch { toggleBtn.disabled = false; }
        return;
      }

      const deleteBtn = event.target.closest("[data-commission-lazy-delete]");
      if (deleteBtn) {
        const action = deleteBtn.dataset.deleteAction;
        if (!action) return;
        try {
          deleteBtn.disabled = true;
          const resp = await fetch(action, { method: "POST", headers: { "X-CSRF-Token": csrfToken } });
          if (resp.ok) window.location.reload();
          else deleteBtn.disabled = false;
        } catch { deleteBtn.disabled = false; }
      }
    });
  })();
</script>
<% } %>
<% if (page.scopeKey === "hr_payroll.commissions" && can("SCREEN", page.scopeKey, "edit")) { %>
<%
  // Recalculate Commission — rewrites stored commission for a past date range.
  //
  // Commission is denormalized at voucher time. Backdated rule saves run an
  // automatic bounded recompute; this modal remains the manual audit/retry path.
  // The date range is deliberately free-form: salary cycles here do not start
  // on the 1st.
  const recalcEmployeeField = (page.fields || []).find(function (field) { return field.name === "employee_id"; });
  const recalcEmployees = (recalcEmployeeField && recalcEmployeeField.options) || [];
  const recalcTypes = [
    { value: "SALESMAN_SALE", labelKey: "commission_type_salesman_sale" },
    { value: "BRANCH_SALE", labelKey: "commission_type_branch_sale" },
    { value: "TRANSFER", labelKey: "commission_type_transfer" },
    { value: "PRODUCTION_FG", labelKey: "commission_type_production_fg" },
    { value: "PRODUCTION_SFG", labelKey: "commission_type_production_sfg" },
  ];
%>
<!-- Backdated rate fallback: automatic recalculation handles normal saves.
     This band is only shown when the automatic pass needs manual review, such
     as an over-limit range. -->
<div class="mx-auto mb-4 hidden max-w-6xl rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900" data-backdate-band>
  <div class="font-semibold" data-backdate-title></div>
  <div class="mt-1 text-xs" data-backdate-body></div>
  <div class="mt-3 flex flex-wrap gap-2">
    <button type="button" data-backdate-review class="cursor-pointer rounded-lg bg-amber-600 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-white transition hover:bg-amber-700">
      <%= t("review_and_recalculate") %>
    </button>
    <button type="button" data-backdate-dismiss class="cursor-pointer rounded-lg border border-amber-300 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-amber-800 transition hover:bg-amber-100">
      <%= t("not_now") %>
    </button>
  </div>
</div>

<div class="fixed inset-0 z-[95] hidden items-center justify-center bg-slate-900/40 p-4" data-recalc-modal>
  <div class="flex max-h-[92vh] w-full max-w-5xl flex-col rounded-2xl border border-slate-200 bg-white shadow-xl" role="dialog" aria-modal="true" aria-labelledby="recalc-title">
    <div class="relative border-b border-slate-200 px-6 py-4">
      <button type="button" data-recalc-close class="absolute right-4 top-4 inline-flex h-8 w-8 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-slate-700" aria-label="<%= t('close') %>">&#10005;</button>
      <div class="text-sm font-semibold text-slate-700" id="recalc-title"><%= t("recalculate_commission") %></div>
      <p class="mt-1 text-xs text-slate-500"><%= t("recalculate_commission_description") %></p>
    </div>

    <div class="flex-1 space-y-4 overflow-y-auto px-6 py-5">
      <div class="rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900">
        <%= t("commission_recalc_today_rates_warning") %>
      </div>

      <div class="grid gap-3 sm:grid-cols-4">
        <label class="block text-xs font-semibold text-slate-600">
          <span><%= t("employees") %></span>
          <select data-recalc-employee class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm">
            <option value=""><%= t("all") %></option>
            <% recalcEmployees.forEach(function (option) { %>
              <option value="<%= option.value %>"><%= option.label %></option>
            <% }); %>
          </select>
        </label>
        <label class="block text-xs font-semibold text-slate-600">
          <span><%= t("from_date") %></span>
          <input type="date" data-recalc-from class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm">
        </label>
        <label class="block text-xs font-semibold text-slate-600">
          <span><%= t("to_date") %></span>
          <input type="date" data-recalc-to class="mt-1 w-full rounded-lg border border-slate-200 px-3 py-2 text-sm">
        </label>
        <div class="flex items-end">
          <button type="button" data-recalc-preview class="w-full cursor-pointer rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-white transition hover:bg-slate-800">
            <%= t("run_preview") %>
          </button>
        </div>
      </div>

      <fieldset class="rounded-lg border border-slate-200 p-3">
        <legend class="px-1 text-xs font-semibold text-slate-600"><%= t("commission_type") %></legend>
        <div class="flex flex-wrap gap-3">
          <% recalcTypes.forEach(function (type) { %>
            <label class="inline-flex items-center gap-2 text-xs text-slate-700">
              <input type="checkbox" data-recalc-type value="<%= type.value %>" checked>
              <span><%= t(type.labelKey) %></span>
            </label>
          <% }); %>
        </div>
      </fieldset>

      <details class="rounded-lg border border-slate-200 p-3">
        <summary class="cursor-pointer text-xs font-semibold text-slate-600"><%= t("commission_recalc_rules_applied") %></summary>
        <div class="mt-2 space-y-1 text-xs text-slate-600" data-recalc-rules><%= t("commission_recalc_no_rules") %></div>
      </details>

      <div class="hidden" data-recalc-results>
        <div class="flex flex-wrap items-center justify-between gap-2 rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-xs text-slate-700">
          <div data-recalc-summary></div>
          <label class="inline-flex items-center gap-2">
            <input type="checkbox" data-recalc-changed-only checked>
            <span><%= t("changed_only") %></span>
          </label>
        </div>

        <div class="mt-3 hidden rounded-lg border border-amber-200 bg-amber-50 p-3 text-xs text-amber-900" data-recalc-orphan-band>
          <div data-recalc-orphan-text></div>
          <label class="mt-2 inline-flex items-center gap-2 font-semibold">
            <input type="checkbox" data-recalc-clear-orphans>
            <span><%= t("clear_unmatched_commission") %></span>
          </label>
        </div>

        <div class="mt-3 max-h-[38vh] overflow-auto rounded-lg border border-slate-200">
          <table class="min-w-full text-xs">
            <thead class="sticky top-0 bg-white">
              <tr class="border-b border-slate-200 text-left uppercase tracking-wide text-slate-500">
                <th class="px-2 py-2"><%= t("date") %></th>
                <th class="px-2 py-2"><%= t("voucher_no") %></th>
                <th class="px-2 py-2"><%= t("employees") %></th>
                <th class="px-2 py-2"><%= t("commission_type") %></th>
                <th class="px-2 py-2 text-right"><%= t("previous_rate") %></th>
                <th class="px-2 py-2 text-right"><%= t("new_rate") %></th>
                <th class="px-2 py-2 text-right"><%= t("change") %></th>
              </tr>
            </thead>
            <tbody data-recalc-rows></tbody>
          </table>
        </div>
      </div>

      <div class="hidden rounded-lg border border-rose-200 bg-rose-50 p-3 text-xs text-rose-800" data-recalc-error></div>
      <div class="hidden rounded-lg border border-emerald-200 bg-emerald-50 p-3 text-xs text-emerald-800" data-recalc-success></div>
    </div>

    <div class="flex items-center justify-end gap-2 border-t border-slate-200 px-6 py-4">
      <button type="button" data-recalc-close class="cursor-pointer rounded-lg border border-slate-200 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-slate-600 transition hover:bg-slate-50">
        <%= t("cancel") %>
      </button>
      <button type="button" data-recalc-apply disabled class="cursor-pointer rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-white transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-40">
        <%= t("apply_changes") %>
      </button>
    </div>
  </div>
</div>

<script>
  (function () {
    const modal = document.querySelector("[data-recalc-modal]");
    if (!modal) return;

    const BASE = "/hr-payroll/employees/commissions";
    const T = <%- JSON.stringify({
      unmatchedHint: t("commission_recalc_unmatched_hint"),
      noRules: t("commission_recalc_no_rules"),
      rows: t("rows"),
      totalChange: t("total_change"),
      scanned: t("commission_recalc_scanned"),
      confirmClear: t("commission_recalc_clear_orphans_warning"),
      apply: t("apply_changes"),
      cancel: t("cancel"),
      title: t("recalculate_commission"),
      dateRequired: t("error_recalc_date_range_required"),
      overLimit: t("error_recalc_over_limit"),
      genericError: t("generic_error"),
    }) %>;

    const el = (sel) => modal.querySelector(sel);
    const employeeSel = el("[data-recalc-employee]");
    const fromInput = el("[data-recalc-from]");
    const toInput = el("[data-recalc-to]");
    const rulesBox = el("[data-recalc-rules]");
    const resultsBox = el("[data-recalc-results]");
    const summaryBox = el("[data-recalc-summary]");
    const rowsBody = el("[data-recalc-rows]");
    const orphanBand = el("[data-recalc-orphan-band]");
    const orphanText = el("[data-recalc-orphan-text]");
    const clearOrphansBox = el("[data-recalc-clear-orphans]");
    const changedOnlyBox = el("[data-recalc-changed-only]");
    const errorBox = el("[data-recalc-error]");
    const successBox = el("[data-recalc-success]");
    const applyBtn = el("[data-recalc-apply]");

    let lastRows = [];
    let lastFilters = null;

    const typeValues = () =>
      Array.from(modal.querySelectorAll("[data-recalc-type]"))
        .filter((box) => box.checked)
        .map((box) => box.value);

    const money = (value) =>
      Number(value || 0).toLocaleString(undefined, {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      });

    const show = (node, on) => node.classList.toggle("hidden", !on);
    const setError = (message) => {
      errorBox.textContent = message || "";
      show(errorBox, Boolean(message));
    };
    const setSuccess = (message) => {
      successBox.textContent = message || "";
      show(successBox, Boolean(message));
    };

    const statusTint = {
      new: "text-emerald-700",
      changed: "text-amber-700",
      cleared: "text-rose-700",
      unchanged: "text-slate-500",
    };

    const renderRows = () => {
      const visible = changedOnlyBox.checked
        ? lastRows.filter((row) => row.status !== "unchanged")
        : lastRows;
      rowsBody.innerHTML = "";
      visible.forEach((row) => {
        const delta = Number(row.new_rate || 0) - Number(row.previous_rate || 0);
        const tr = document.createElement("tr");
        tr.className = "border-b border-slate-100";
        const cells = [
          row.voucher_date,
          "#" + row.voucher_no,
          row.employee_name,
          row.commission_type,
          row.previous_rate === null ? "-" : money(row.previous_rate),
          money(row.new_rate),
          (delta > 0 ? "+" : "") + money(delta),
        ];
        cells.forEach((text, index) => {
          const td = document.createElement("td");
          let cls = "px-2 py-1.5";
          if (index >= 4) cls += " text-right tabular-nums";
          if (index === 3) cls += " " + (statusTint[row.status] || "");
          if (index === 6) cls += " " + (delta < 0 ? "text-rose-700" : "text-emerald-700");
          td.className = cls;
          td.textContent = text;
          tr.appendChild(td);
        });
        rowsBody.appendChild(tr);
      });
    };

    const loadRules = async () => {
      const params = new URLSearchParams();
      if (employeeSel.value) params.set("employee_id", employeeSel.value);
      params.set("commission_types", typeValues().join(","));
      try {
        const res = await fetch(BASE + "/recalc-rules?" + params.toString(), {
          headers: { Accept: "application/json" },
        });
        const data = await res.json();
        const rules = (data && data.rules) || [];
        rulesBox.innerHTML = "";
        if (!rules.length) {
          rulesBox.textContent = T.noRules;
          return;
        }
        rules.forEach((rule) => {
          const line = document.createElement("div");
          line.textContent =
            rule.employee_name +
            " — " + rule.commission_type +
            " / " + rule.commission_basis +
            " / " + rule.apply_on +
            " — " + money(rule.value) +
            " (" + rule.rate_type + ")";
          rulesBox.appendChild(line);
        });
      } catch (err) {
        rulesBox.textContent = T.noRules;
      }
    };

    const runPreview = async () => {
      setError("");
      setSuccess("");
      applyBtn.disabled = true;
      const types = typeValues();
      if (!fromInput.value || !toInput.value || !types.length) {
        setError(T.dateRequired);
        return;
      }
      const params = new URLSearchParams();
      params.set("from_date", fromInput.value);
      params.set("to_date", toInput.value);
      params.set("commission_types", types.join(","));
      if (employeeSel.value) params.set("employee_id", employeeSel.value);
      if (clearOrphansBox.checked) params.set("clear_orphans", "1");

      try {
        const res = await fetch(BASE + "/recalc-preview?" + params.toString(), {
          headers: { Accept: "application/json" },
        });
        const data = await res.json();
        if (!res.ok) {
          setError((data && data.message) || T.genericError);
          return;
        }
        lastRows = data.rows || [];
        lastFilters = data.filters || null;
        const counts = data.counts || {};
        const totals = data.totals || {};

        summaryBox.textContent =
          T.scanned + ": " + (counts.scanned_vouchers || 0) +
          " · " + T.rows + ": " + (counts.writes || 0) + "/" + (counts.rows || 0) +
          " · " + T.totalChange + ": " +
          (Number(totals.delta || 0) > 0 ? "+" : "") + money(totals.delta);

        show(orphanBand, Boolean(counts.cleared));
        if (counts.cleared) {
          orphanText.textContent = T.unmatchedHint + " (" + counts.cleared + ")";
        }

        show(resultsBox, true);
        renderRows();
        applyBtn.disabled = !(counts.writes > 0) || Boolean(data.over_limit);
        if (data.over_limit) setError(T.overLimit);
      } catch (err) {
        setError(String((err && err.message) || err));
      }
    };

    const apply = async () => {
      if (!lastFilters) return;
      if (clearOrphansBox.checked) {
        // Zeroing unmatched commission removes pay that may already have been
        // issued, so it always needs an explicit acknowledgement.
        const confirmed =
          typeof window.showUiConfirmModal === "function"
            ? await window.showUiConfirmModal({
                title: T.title,
                message: T.confirmClear,
                confirmLabel: T.apply,
                cancelLabel: T.cancel,
              })
            : window.confirm(T.confirmClear);
        if (!confirmed) return;
      }
      setError("");
      applyBtn.disabled = true;
      try {
        const res = await fetch(BASE + "/recalc", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
            // The csrf middleware reads x-csrf-token (or _csrf in the body);
            // "CSRF-Token" is not a name it looks at.
            "x-csrf-token": "<%= csrfToken %>",
          },
          body: JSON.stringify({
            _csrf: "<%= csrfToken %>",
            from_date: lastFilters.from_date,
            to_date: lastFilters.to_date,
            commission_types: lastFilters.commission_types,
            employee_id: lastFilters.employee_id || "",
            clear_orphans: clearOrphansBox.checked ? "1" : "",
          }),
        });
        const data = await res.json();
        if (!res.ok && res.status !== 202) {
          setError((data && data.message) || T.genericError);
          applyBtn.disabled = false;
          return;
        }
        setSuccess((data && data.message) || "");
        show(resultsBox, false);
      } catch (err) {
        setError(String((err && err.message) || err));
        applyBtn.disabled = false;
      }
    };

    const openModal = () => {
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      setError("");
      setSuccess("");
      show(resultsBox, false);
      applyBtn.disabled = true;
      loadRules();
    };
    const closeModal = () => {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
    };

    document.querySelectorAll("[data-recalc-open]").forEach((btn) =>
      btn.addEventListener("click", openModal),
    );

    // Entry point for the backdated-rate prompt: opens this same modal with the
    // range, employee and commission type already filled in, then runs the
    // preview so the approver lands straight on the old -> new diff. Nothing is
    // written here -- Apply still routes through approvals exactly as before.
    window.openCommissionRecalc = (opts) => {
      const options = opts && typeof opts === "object" ? opts : {};
      openModal();
      if (options.from_date) fromInput.value = options.from_date;
      if (options.to_date) toInput.value = options.to_date;
      if (options.employee_id && employeeSel) {
        employeeSel.value = String(options.employee_id);
        loadRules();
      }
      if (options.commission_type) {
        modal.querySelectorAll("[data-recalc-type]").forEach((box) => {
          box.checked = box.value === options.commission_type;
        });
      }
      runPreview();
    };
    modal.querySelectorAll("[data-recalc-close]").forEach((btn) =>
      btn.addEventListener("click", closeModal),
    );
    modal.addEventListener("click", (event) => {
      if (event.target === modal) closeModal();
    });
    // Backdate prompt wiring. Two sources feed it: the server-rendered notice
    // after a single-rule save (which redirects), and the JSON `backdate` field
    // returned by the bulk save (which does not).
    (() => {
      const band = document.querySelector("[data-backdate-band]");
      if (!band) return;
      const titleEl = band.querySelector("[data-backdate-title]");
      const bodyEl = band.querySelector("[data-backdate-body]");
      const tTitle = "<%= t('backdated_recalc_title') %>";
      const tBody = "<%= t('backdated_recalc_body') %>";
      let pending = null;

      const hide = () => band.classList.add("hidden");

      window.showCommissionBackdateNotice = (notice) => {
        if (!notice || !notice.backdated) return;
        pending = notice;
        titleEl.textContent = tTitle;
        bodyEl.textContent = tBody.replace(
          "{count}",
          String(notice.affected_vouchers || 0),
        );
        band.classList.remove("hidden");
        band.scrollIntoView({ behavior: "smooth", block: "nearest" });
      };

      band
        .querySelector("[data-backdate-dismiss]")
        .addEventListener("click", hide);
      band.querySelector("[data-backdate-review]").addEventListener("click", () => {
        hide();
        if (pending && typeof window.openCommissionRecalc === "function") {
          window.openCommissionRecalc(pending);
        }
      });

      <% if (typeof commissionBackdateNotice !== "undefined" && commissionBackdateNotice) { %>
      window.showCommissionBackdateNotice(<%- JSON.stringify(commissionBackdateNotice) %>);
      <% } %>
    })();

    el("[data-recalc-preview]").addEventListener("click", runPreview);
    applyBtn.addEventListener("click", apply);
    changedOnlyBox.addEventListener("change", renderRows);
    clearOrphansBox.addEventListener("change", runPreview);
    employeeSel.addEventListener("change", loadRules);
    modal.querySelectorAll("[data-recalc-type]").forEach((box) =>
      box.addEventListener("change", loadRules),
    );
  })();
</script>
<% } %>
