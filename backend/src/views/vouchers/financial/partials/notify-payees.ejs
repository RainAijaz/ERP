<% const allowedNotifyPayees = (notifyPayeePermissions || []).filter((entry) => entry.allowed); %>
<% if (allowedNotifyPayees.length) { %>
<div class="grid grid-cols-1 gap-3 lg:grid-cols-12 lg:items-start">
  <span class="text-sm font-semibold text-slate-700 lg:col-span-2"></span>
  <div class="lg:col-span-10">
    <input type="hidden" name="notify_payees_present" value="1">
    <div class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
      <div class="flex items-start gap-3">
        <span class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-green-50 text-green-600">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.940 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.978-1.413A9.953 9.953 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a7.95 7.95 0 01-4.054-1.11l-.29-.173-3.006.854.854-2.939-.19-.302A7.96 7.96 0 014 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8z" clip-rule="evenodd"/>
          </svg>
        </span>
        <div class="min-w-0 flex-1">
          <p class="text-sm font-semibold text-slate-700"><%= t('notify_payees_on_approval') %></p>
          <p class="mt-0.5 text-xs text-slate-400"><%= t('notify_payees_on_approval_hint') %></p>
          <div class="mt-3 grid gap-2 sm:grid-cols-3">
            <% allowedNotifyPayees.forEach((entry) => { %>
              <label class="flex cursor-pointer items-start gap-2 rounded-lg border border-slate-200 bg-white px-3 py-2 transition hover:bg-slate-50">
                <input type="checkbox" name="notify_payee_kinds" value="<%= entry.kind %>"
                       class="mt-0.5 h-4 w-4 shrink-0 rounded border-slate-300 text-green-600 focus:ring-green-500">
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-slate-700"><%= t(entry.labelKey) %></span>
                  <span class="block text-xs text-slate-400"><%= t(entry.hintKey) %></span>
                </span>
              </label>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<% } else { %>
  <input type="hidden" name="notify_payees_present" value="1">
<% } %>
